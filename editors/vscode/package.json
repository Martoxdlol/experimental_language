{
  "name": "otter-fusion",
  "displayName": "Otter Fusion",
  "description": "Otter Fusion language support: diagnostics, hover, go-to-definition, references, rename, symbols, completion, and semantic highlighting.",
  "version": "0.1.5",
  "publisher": "experimental",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "icon": "otter_fusion.png",
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "otter-fusion",
        "aliases": [
          "Otter Fusion",
          "otter"
        ],
        "extensions": [
          ".otter"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./otter_fusion_small.png",
          "dark": "./otter_fusion_small.png"
        }
      }
    ],
    "grammars": [
      {
        "language": "otter-fusion",
        "scopeName": "source.otter-fusion",
        "path": "./syntaxes/grammar.tmLanguage.json"
      }
    ],
    "semanticTokenScopes": [
      {
        "language": "otter-fusion",
        "scopes": {
          "type": [
            "entity.name.type.otter-fusion",
            "support.type.otter-fusion"
          ],
          "struct": [
            "entity.name.type.struct.otter-fusion",
            "entity.name.type.otter-fusion"
          ],
          "interface": [
            "entity.name.type.interface.otter-fusion",
            "entity.name.type.otter-fusion"
          ],
          "function": [
            "entity.name.function.otter-fusion"
          ],
          "method": [
            "entity.name.function.method.otter-fusion",
            "entity.name.function.otter-fusion"
          ],
          "variable": [
            "variable.other.otter-fusion"
          ],
          "parameter": [
            "variable.parameter.otter-fusion"
          ],
          "property": [
            "variable.other.property.otter-fusion",
            "variable.other.member.otter-fusion"
          ]
        }
      }
    ],
    "configuration": {
      "title": "Otter Fusion",
      "properties": {
        "otter-fusion.server.path": {
          "type": "string",
          "default": "otter_fusion_lsp",
          "description": "Path to the `otter_fusion_lsp` language server binary. If it is on your PATH the default works; otherwise give an absolute path (e.g. target/debug/otter_fusion_lsp)."
        },
        "otter-fusion.runner.path": {
          "type": "string",
          "default": "otter_fusion",
          "description": "Path to the `otter_fusion` CLI used by the Run / Build code lenses above `main`."
        },
        "otter-fusion.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "description": "Trace the communication between VS Code and the language server."
        }
      }
    },
    "commands": [
      {
        "command": "otter-fusion.restartServer",
        "title": "Otter Fusion: Restart Language Server"
      },
      {
        "command": "otter-fusion.runFile",
        "title": "Otter Fusion: Run File"
      },
      {
        "command": "otter-fusion.buildFile",
        "title": "Otter Fusion: Build File"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -w -p ./",
    "package": "vsce package --allow-missing-repository --out otter-fusion-${npm_package_version}.vsix",
    "install-extension": "code --install-extension otter-fusion-${npm_package_version}.vsix"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.2.0",
    "typescript": "^5.4.0"
  }
}