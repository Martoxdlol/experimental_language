extend DirEntries: Iterator<DirEntry | IoError> {
  function next(self): Item<DirEntry | IoError> | Done {
    if self.index >= self.entries.size() {
      Done {}
    } else {
      var entry: DirEntry | IoError = self.entries[self.index].clone();
      self.index = self.index + 1;
      Item { value: entry }
    }
  }
}

extend OpenOptions {
  function new(): OpenOptions {
    OpenOptions {
      read: false,
      write: false,
      append: false,
      truncate: false,
      create: false,
      create_new: false
    }
  }

  function read(self): bool { self.read }

  function write(self): bool { self.write }

  function append(self): bool { self.append }

  function truncate(self): bool { self.truncate }

  function create(self): bool { self.create }

  function create_new(self): bool { self.create_new }

  function with_read(self, value: bool): OpenOptions {
    OpenOptions {
      read: value,
      write: self.write,
      append: self.append,
      truncate: self.truncate,
      create: self.create,
      create_new: self.create_new
    }
  }

  function with_write(self, value: bool): OpenOptions {
    OpenOptions {
      read: self.read,
      write: value,
      append: self.append,
      truncate: self.truncate,
      create: self.create,
      create_new: self.create_new
    }
  }

  function with_append(self, value: bool): OpenOptions {
    OpenOptions {
      read: self.read,
      write: self.write,
      append: value,
      truncate: self.truncate,
      create: self.create,
      create_new: self.create_new
    }
  }

  function with_truncate(self, value: bool): OpenOptions {
    OpenOptions {
      read: self.read,
      write: self.write,
      append: self.append,
      truncate: value,
      create: self.create,
      create_new: self.create_new
    }
  }

  function with_create(self, value: bool): OpenOptions {
    OpenOptions {
      read: self.read,
      write: self.write,
      append: self.append,
      truncate: self.truncate,
      create: value,
      create_new: self.create_new
    }
  }

  function with_create_new(self, value: bool): OpenOptions {
    OpenOptions {
      read: self.read,
      write: self.write,
      append: self.append,
      truncate: self.truncate,
      create: self.create,
      create_new: value
    }
  }

  function validation_error(self): IoError | null {
    if !self.read && !self.write && !self.append {
      __fs_io_error("filesystem open options must enable read, write, or append")
    } else if self.truncate && !__fs_options_can_write(self) {
      __fs_io_error("filesystem open options using truncate require write or append access")
    } else if self.create && !__fs_options_can_write(self) {
      __fs_io_error("filesystem open options using create require write or append access")
    } else if self.create_new && !__fs_options_can_write(self) {
      __fs_io_error("filesystem open options using create_new require write or append access")
    } else {
      null
    }
  }

  function validate(self): null | IoError {
    var error = self.validation_error();
    if error is IoError {
      error as IoError
    } else {
      null
    }
  }

  function is_valid(self): bool {
    self.validation_error() is null
  }
}

extend OpenOptions: Eq {
  function eq(self, other: OpenOptions): bool {
    self.read == other.read &&
    self.write == other.write &&
    self.append == other.append &&
    self.truncate == other.truncate &&
    self.create == other.create &&
    self.create_new == other.create_new
  }
}

extend OpenOptions: Clone {
  function clone(self): OpenOptions {
    OpenOptions {
