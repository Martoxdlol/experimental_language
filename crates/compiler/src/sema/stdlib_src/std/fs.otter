extend File: AsyncReader + AsyncWriter {
  function open(path: Path): Future<File | IoError> async {
    await __fs_open_file(path, "open", false)
  }

  function create(path: Path): Future<File | IoError> async {
    await __fs_open_file(path, "create", false)
  }

  function append(path: Path): Future<File | IoError> async {
    await __fs_open_file(path, "append", true)
  }

  function open_with(path: Path, options: OpenOptions): Future<File | IoError> async {
    await __fs_open_file_options(path, options)
  }

  function path(self): Path { self.path.clone() }

  function is_append_mode(self): bool { self.append_mode }

  function handle_id(self): i64 { self.handle }

  function read_to_string(self): Future<str | IoError> async {
    await read_to_string(self.path)
  }

  function write_string(self, contents: str): Future<null | IoError> async {
    if self.append_mode {
      await append_string(self.path, contents)
    } else {
      await write_string(self.path, contents)
    }
  }

  function append_string(self, contents: str): Future<null | IoError> async {
    await append_string(self.path, contents)
  }

  function close(self): Future<null | IoError> async {
    var raw = await __otter_fs_file_close_async(self.handle);
    __fs_decode_unit(raw)
  }

  function read_async(self, buf: Bytes): Future<i64 | IoError> async {
    var raw = await __otter_fs_file_read_async(self.handle, buf.size());
    var data = __fs_decode_bytes(raw);
    if data is IoError {
      data as IoError
    } else {
      var chunk = data as Bytes;
      for b in chunk.iter() {
        buf.push(b);
      }
      chunk.size()
    }
  }

  function read_to_end_async(self, buf: Bytes): Future<i64 | IoError> async {
    var raw = await __otter_fs_file_read_to_end_async(self.handle);
    var data = __fs_decode_bytes(raw);
    if data is IoError {
      data as IoError
    } else {
      var chunk = data as Bytes;
      for b in chunk.iter() {
        buf.push(b);
      }
      chunk.size()
    }
  }

  function write_async(self, buf: Bytes): Future<i64 | IoError> async {
    var raw = await __otter_fs_file_write_async(self.handle, __fs_bytes_to_hex(buf));
    __fs_decode_i64(raw)
  }

  function write_all_async(self, buf: Bytes): Future<null | IoError> async {
    var written = await self.write_async(buf);
    if written is IoError {
      written as IoError
    } else {
      null
    }
  }

  function flush_async(self): Future<null | IoError> async {
    var raw = await __otter_fs_file_flush_async(self.handle);
    __fs_decode_unit(raw)
  }

  function seek_async(self, pos: SeekFrom): Future<i64 | IoError> async {
    if pos is Start {
      var offset = (pos as Start).offset;
      if offset > 9223372036854775807u64 {
        __fs_io_error("invalid seek")
      } else {
        var raw = await __otter_fs_file_seek_async(self.handle, "start", offset as i64);
        __fs_decode_i64(raw)
      }
    } else if pos is Current {
      var raw = await __otter_fs_file_seek_async(self.handle, "current", (pos as Current).offset);
      __fs_decode_i64(raw)
    } else {
      var raw = await __otter_fs_file_seek_async(self.handle, "end", (pos as End).offset);
      __fs_decode_i64(raw)
    }
  }
}

extend File {
  function read(self, buf: Bytes): Future<i64 | IoError> async {
    await self.read_async(buf)
  }

  function read_to_end(self, buf: Bytes): Future<i64 | IoError> async {
    await self.read_to_end_async(buf)
  }

  function write(self, buf: Bytes): Future<i64 | IoError> async {
    await self.write_async(buf)
  }

  function write_all(self, buf: Bytes): Future<null | IoError> async {
    await self.write_all_async(buf)
  }

  function flush(self): Future<null | IoError> async {
    await self.flush_async()
  }

  function seek(self, pos: SeekFrom): Future<i64 | IoError> async {
    await self.seek_async(pos)
  }
}

