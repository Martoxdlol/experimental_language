      create: self.create,
      create_new: self.create_new
    }
  }
}

extend OpenOptions: Hash {
  function hash(self): u64 {
    var out = 0u64;
    if self.read { out = out + 1u64; }
    if self.write { out = out + 2u64; }
    if self.append { out = out + 4u64; }
    if self.truncate { out = out + 8u64; }
    if self.create { out = out + 16u64; }
    if self.create_new { out = out + 32u64; }
    out
  }
}

extend OpenOptions: ToStr {
  function to_str(self): str {
    "OpenOptions(read=" + (self.read as str) +
    ", write=" + (self.write as str) +
    ", append=" + (self.append as str) +
