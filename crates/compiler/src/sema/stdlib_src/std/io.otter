  }
}

extend BufWriter {
  function new(inner: Writer): BufWriter {
    BufWriter.with_capacity(8192, inner)
  }

  function with_capacity(capacity: i64, inner: Writer): BufWriter {
    var cap = capacity;
    if cap <= 0 {
      cap = 8192;
    }
    BufWriter { inner: inner, buffer: Bytes.new(), capacity: cap }
  }

  function buffered_len(self): i64 { self.buffer.size() }
}

extend BufWriter: Writer {
  function write(self, buf: Bytes): i64 | IoError {
    for b in buf.iter() {
      self.buffer.push(b);
    }
    if self.buffer.size() >= self.capacity {
      var flushed = self.flush();
      if flushed is IoError {
        return flushed as IoError;
      }
    }
    buf.size()
  }

  function write_all(self, buf: Bytes): null | IoError {
    var written = self.write(buf);
    if written is IoError {
      written as IoError
    } else {
      null
    }
  }

  function flush(self): null | IoError {
    if self.buffer.is_empty() {
      self.inner.flush()
    } else {
      var pending = self.buffer.clone();
      var wrote = self.inner.write_all(pending);
      if wrote is IoError {
        wrote as IoError
      } else {
        self.buffer = Bytes.new();
        self.inner.flush()
      }
    }
  }
}
