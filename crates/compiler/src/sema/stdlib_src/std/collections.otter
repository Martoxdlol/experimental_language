struct Deque<T> {
  front: List<T>,
  back: List<T>,
}

struct DequeIter<T> {
  snapshot: List<T>,
  index: i64,
}

function deque<T>(): Deque<T> {
  Deque { front: List<T>(), back: List<T>() }
}

function deque_from_list<T>(values: List<T>): Deque<T> {
  var out = deque<T>();
  for value in values.iter() {
    out.push_back(value);
  }
  out
}

extend<T> Deque<T> {
  function new(): Deque<T> {
    Deque { front: List<T>(), back: List<T>() }
  }

  function size(self): i64 { self.front.size() + self.back.size() }

  function is_empty(self): bool { self.size() == 0 }

  function push_front(self, value: T) {
    self.front.push(value);
  }

  function push_back(self, value: T) {
    self.back.push(value);
  }

  function extend_front(self, values: List<T>) {
    var i = values.size() - 1;
    while i >= 0 {
      self.push_front(values[i]);
      i = i - 1;
    }
  }

  function extend_back(self, values: List<T>) {
    for value in values.iter() {
      self.push_back(value);
    }
  }

  function refill_front(self) {
    while self.back.size() > 0 {
      var value = self.back.pop();
      if value is T {
        self.front.push(value as T);
      }
    }
  }

  function refill_back(self) {
    while self.front.size() > 0 {
      var value = self.front.pop();
      if value is T {
        self.back.push(value as T);
      }
    }
  }

  function pop_front(self): T | null {
    if self.front.is_empty() {
      self.refill_front();
    }
    self.front.pop()
  }

  function pop_back(self): T | null {
    if self.back.is_empty() {
      self.refill_back();
    }
    self.back.pop()
  }

  function front(self): T | null {
    if !self.front.is_empty() {
      self.front[self.front.size() - 1]
    } else if !self.back.is_empty() {
      self.back[0]
    } else {
      null
    }
  }

  function back(self): T | null {
    if !self.back.is_empty() {
      self.back[self.back.size() - 1]
    } else if !self.front.is_empty() {
      self.front[0]
    } else {
      null
    }
  }

  function get(self, index: i64): T | null {
    if index < 0 || index >= self.size() {
      null
    } else if index < self.front.size() {
      self.front[self.front.size() - 1 - index]
    } else {
      self.back[index - self.front.size()]
    }
  }

  function set(self, index: i64, value: T): bool {
    if index < 0 || index >= self.size() {
      false
    } else if index < self.front.size() {
      self.front[self.front.size() - 1 - index] = value;
      true
    } else {
      self.back[index - self.front.size()] = value;
      true
    }
  }

  function remove_at(self, index: i64): T | null {
    if index < 0 || index >= self.size() {
      null
    } else if index < self.front.size() {
      var storage_index = self.front.size() - 1 - index;
      var value = self.front[storage_index];
      self.front.remove(storage_index);
      value
    } else {
      var storage_index = index - self.front.size();
      var value = self.back[storage_index];
      self.back.remove(storage_index);
      value
    }
  }

  function to_list(self): List<T> {
    var out = List<T>();
    var i = self.front.size() - 1;
    while i >= 0 {
      out.push(self.front[i]);
      i = i - 1;
    }
    for value in self.back.iter() {
      out.push(value);
    }
    out
  }

  function iter(self): Iterator<T> {
    DequeIter { snapshot: self.to_list(), index: 0 }
  }

  function clear(self) {
    self.front.clear();
    self.back.clear();
  }
}

extend<T: Eq> Deque<T> {
  function contains(self, needle: T): bool {
    var found = false;
    for value in self.iter() {
      if value == needle {
        found = true;
      }
    }
    found
  }
}

extend<T> DequeIter<T>: Iterator<T> {
  function next(self): Item<T> | Done {
    if self.index >= self.snapshot.size() {
      Done {}
    } else {
      var value = self.snapshot[self.index];
      self.index = self.index + 1;
      Item { value: value }
    }
  }
}

extend<T: Eq> Deque<T>: Eq {
  function eq(self, other: Deque<T>): bool {
    if self.size() != other.size() {
      false
    } else {
      var left = self.to_list();
      var right = other.to_list();
      var same = true;
      var i = 0;
      while same && i < left.size() {
        same = left[i] == right[i];
        i = i + 1;
      }
      same
    }
  }
}

extend<T: Clone> Deque<T>: Clone {
  function clone(self): Deque<T> {
    var out = deque<T>();
    for value in self.iter() {
      out.push_back(value.clone());
    }
    out
  }
}

extend<T: Hash> Deque<T>: Hash {
  function hash(self): u64 {
    var h = 2166136261u64;
    for value in self.iter() {
      h = ((h % 4294967291u64) * 16777619u64 + value.hash()) % 4294967291u64;
    }
    h
  }
}

extend<T: ToStr> Deque<T>: ToStr {
  function to_str(self): str {
    var out = "Deque[";
    var first = true;
    for value in self.iter() {
      if first {
        first = false;
      } else {
        out = out + ",";
      }
      out = out + value.to_str();
    }
    out + "]"
  }
}

extend<T: Debug> Deque<T>: Debug {
  function debug(self): str {
    var out = "Deque[";
    var first = true;
    for value in self.iter() {
      if first {
        first = false;
      } else {
        out = out + ", ";
      }
      out = out + value.debug();
    }
    out + "]"
  }
}
