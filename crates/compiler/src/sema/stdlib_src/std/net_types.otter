    }
    out = out + self.path;
    if self.query is str {
      out = out + "?" + (self.query as str);
    }
    if self.fragment is str {
      out = out + "#" + (self.fragment as str);
    }
    out
  }
}

extend Uri: Eq {
  function eq(self, other: Uri): bool {
    self.scheme == other.scheme
      && __net_str_option_eq(self.authority, other.authority)
      && self.path == other.path
      && __net_str_option_eq(self.query, other.query)
      && __net_str_option_eq(self.fragment, other.fragment)
  }
}

extend Uri: Clone {
