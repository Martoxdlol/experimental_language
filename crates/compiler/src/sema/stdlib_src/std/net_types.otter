      || self.path != other.path
      || !__net_str_option_eq(self.fragment, other.fragment)
      || self.query.size() != other.query.size() {
      false
    } else {
      var same = true;
      for entry in self.query {
        if same {
          var other_value = other.query.get(entry.key);
          if other_value is str {
            same = entry.value == (other_value as str);
          } else {
            same = false;
          }
        }
      }
      same
    }
  }
