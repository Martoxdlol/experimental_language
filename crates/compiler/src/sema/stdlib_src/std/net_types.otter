      host: self.host,
      port: port,
      path: self.path,
      query: __net_clone_query(self.query),
      fragment: self.fragment,
    }
  }

  function with_path(self, path: str): Url {
    Url {
      scheme: self.scheme,
      user: self.user,
      host: self.host,
      port: self.port,
      path: path,
      query: __net_clone_query(self.query),
      fragment: self.fragment,
    }
  }

  function with_query(self, query: Map<str, str>): Url {
    Url {
      scheme: self.scheme,
      user: self.user,
      host: self.host,
      port: self.port,
      path: self.path,
      query: __net_clone_query(query),
      fragment: self.fragment,
    }
  }

  function with_query_param(self, key: str, value: str): Url {
    var query = __net_clone_query(self.query);
    query.set(key, value);
    self.with_query(query)
  }

  function without_query_param(self, key: str): Url {
    var query = __net_clone_query(self.query);
    query.remove(key);
    self.with_query(query)
  }

  function clear_query(self): Url {
    self.with_query(Map.new<str, str>())
  }

  function with_fragment(self, fragment: str | null): Url {
    Url {
      scheme: self.scheme,
      user: self.user,
      host: self.host,
      port: self.port,
      path: self.path,
      query: __net_clone_query(self.query),
      fragment: fragment,
    }
  }

  function query_string(self): str {
    var out = "";
    var first = true;
    for entry in self.query {
      if first {
        first = false;
      } else {
        out = out + "&";
      }
      out = out + entry.key + "=" + entry.value;
    }
    out
  }

  function render(self): str {
    var out = self.scheme + "://";
    if self.user is str {
      out = out + (self.user as str) + "@";
    }
    out = out + self.host;
    if self.port is u16 {
      out = out + ":" + ((self.port as u16) as str);
    }
    out = out + self.path;
    if !self.query.is_empty() {
      out = out + "?" + self.query_string();
    }
    if self.fragment is str {
      out = out + "#" + (self.fragment as str);
