extend IpAddr: Hash {
  function hash(self): u64 {
    var h = self.version as u64;
    if self.zone is str {
      h = h * 16777619u64 + (self.zone as str).hash();
    }
    h = h * 16777619u64 + self.a as u64;
    h = h * 16777619u64 + self.b as u64;
    h = h * 16777619u64 + self.c as u64;
    h = h * 16777619u64 + self.d as u64;
    h = h * 16777619u64 + self.e as u64;
    h = h * 16777619u64 + self.f as u64;
    h = h * 16777619u64 + self.g as u64;
