    if self.user is str {
      out = __net_hash_add(out, ("user:" + (self.user as str)).hash());
    } else {
      out = __net_hash_add(out, "user:null".hash());
    }
    out = __net_hash_add(out, ("host:" + self.host).hash());
    if self.port is u16 {
      out = __net_hash_add(out, ("port:" + ((self.port as u16) as str)).hash());
    } else {
      out = __net_hash_add(out, "port:null".hash());
    }
    out = __net_hash_add(out, ("path:" + self.path).hash());
    if self.fragment is str {
      out = __net_hash_add(out, ("fragment:" + (self.fragment as str)).hash());
    } else {
