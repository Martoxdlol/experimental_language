  lang_atomic_ptr_compare_exchange(
  ptr: *u8,
  expected: *u8,
  new: *u8,
  success: i64,
  failure: i64
): *u8;

function ordering_relaxed(): Ordering { Relaxed {} }
function ordering_acquire(): Ordering { Acquire {} }
function ordering_release(): Ordering { Release {} }
function ordering_acq_rel(): Ordering { AcqRel {} }
function ordering_seq_cst(): Ordering { SeqCst {} }

function __atomic_order_code(ord: Ordering): i64 {
  if ord is Relaxed {
    0
  } else if ord is Acquire {
    1
  } else if ord is Release {
    2
  } else if ord is AcqRel {
    3
  } else {
    4
  }
}

function __atomic_load_order(ord: Ordering): i64 {
  if ord is Release || ord is AcqRel {
    panic("invalid atomic load ordering")
  } else {
    __atomic_order_code(ord)
  }
}

function __atomic_store_order(ord: Ordering): i64 {
  if ord is Acquire || ord is AcqRel {
    panic("invalid atomic store ordering")
  } else {
    __atomic_order_code(ord)
  }
}

function __atomic_failure_order(ord: Ordering): i64 {
  if ord is Release || ord is AcqRel {
    panic("invalid atomic compare_exchange failure ordering")
  } else {
    __atomic_order_code(ord)
  }
}

function __atomic_bool_code(value: bool): i64 {
  if value { 1 } else { 0 }
}

function __atomic_bool_value(value: i64): bool {
  value != 0
}

extend Ordering {
  function as_str(self): str {
    if self is Relaxed {
      "relaxed"
    } else if self is Acquire {
      "acquire"
    } else if self is Release {
      "release"
    } else if self is AcqRel {
      "acq_rel"
    } else {
      "seq_cst"
    }
  }

  function debug_string(self): str {
    if self is Relaxed {
      "Relaxed"
    } else if self is Acquire {
      "Acquire"
    } else if self is Release {
      "Release"
    } else if self is AcqRel {
      "AcqRel"
    } else {
      "SeqCst"
    }
  }

  function equals(self, other: Ordering): bool {
    self.as_str() == other.as_str()
  }
}

extend Ordering: Eq {
  function eq(self, other: Ordering): bool { self.equals(other) }
}

extend Ordering: Clone {
  function clone(self): Ordering {
    if self is Relaxed {
      Relaxed {}
    } else if self is Acquire {
      Acquire {}
    } else if self is Release {
      Release {}
    } else if self is AcqRel {
      AcqRel {}
    } else {
      SeqCst {}
    }
  }
}

extend Ordering: Hash {
  function hash(self): u64 { self.as_str().hash() }
}

extend Ordering: ToStr {
  function to_str(self): str { self.as_str() }
}

extend Ordering: Debug {
  function debug(self): str { self.debug_string() }
}

extend AtomicI64 {
  function new(v: i64): AtomicI64 {
    AtomicI64 { ptr: lang_atomic_i64_new(v) }
  }

  function load(self, ord: Ordering): i64 {
    lang_atomic_i64_load(self.ptr, __atomic_load_order(ord))
  }

  function store(self, v: i64, ord: Ordering): null {
    lang_atomic_i64_store(self.ptr, v, __atomic_store_order(ord));
    null
  }

  function swap(self, v: i64, ord: Ordering): i64 {
    lang_atomic_i64_swap(self.ptr, v, __atomic_order_code(ord))
  }

  function compare_exchange(self, expected: i64, new: i64, success: Ordering, failure: Ordering):
    i64 |
    i64 {
    lang_atomic_i64_compare_exchange(
      self.ptr,
      expected,
      new,
      __atomic_order_code(success),
      __atomic_failure_order(failure)
    )
  }

  function fetch_add(self, v: i64, ord: Ordering): i64 {
    lang_atomic_i64_fetch_add(self.ptr, v, __atomic_order_code(ord))
  }

  function fetch_sub(self, v: i64, ord: Ordering): i64 {
    lang_atomic_i64_fetch_sub(self.ptr, v, __atomic_order_code(ord))
  }
}

extend AtomicI64: Clone {
  function clone(self): AtomicI64 {
    self
  }
}

extend AtomicI64: Drop {
  function drop(self) {
    lang_atomic_i64_free(self.ptr);
  }
}

