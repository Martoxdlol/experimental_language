extern function lang_atomic_u32_new(value: u32): *u8;
extern function lang_atomic_u32_free(ptr: *u8);
extern function lang_atomic_u32_load(ptr: *u8, ord: i64): u32;
extern function lang_atomic_u32_store(ptr: *u8, value: u32, ord: i64);
extern function lang_atomic_u32_swap(ptr: *u8, value: u32, ord: i64): u32;
