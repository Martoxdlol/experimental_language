struct Relaxed {}
struct Acquire {}
struct Release {}
struct AcqRel {}
struct SeqCst {}
type Ordering = Relaxed | Acquire | Release | AcqRel | SeqCst;

@RefCounted
struct AtomicI64 { ptr: *u8 }

@RefCounted
struct AtomicI32 { ptr: *u8 }

@RefCounted
struct AtomicU64 { ptr: *u8 }

@RefCounted
struct AtomicU32 { ptr: *u8 }

@RefCounted
struct AtomicBool { ptr: *u8 }

@RefCounted
struct AtomicPtr<T> { ptr: *u8 }

extern function lang_atomic_i64_new(value: i64): *u8;
extern function lang_atomic_i64_free(ptr: *u8);
extern function lang_atomic_i64_load(ptr: *u8, ord: i64): i64;
extern function lang_atomic_i64_store(ptr: *u8, value: i64, ord: i64);
extern function lang_atomic_i64_swap(ptr: *u8, value: i64, ord: i64): i64;
extern function
  lang_atomic_i64_compare_exchange(
  ptr: *u8,
  expected: i64,
  new: i64,
  success: i64,
  failure: i64
): i64;
extern function lang_atomic_i64_fetch_add(ptr: *u8, value: i64, ord: i64): i64;
extern function lang_atomic_i64_fetch_sub(ptr: *u8, value: i64, ord: i64): i64;

