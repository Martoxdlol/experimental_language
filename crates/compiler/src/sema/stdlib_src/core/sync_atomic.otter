extern function lang_atomic_u32_fetch_sub(ptr: *u8, value: u32, ord: i64): u32;

extern function lang_atomic_bool_new(value: i64): *u8;
extern function lang_atomic_bool_free(ptr: *u8);
extern function lang_atomic_bool_load(ptr: *u8, ord: i64): i64;
extern function lang_atomic_bool_store(ptr: *u8, value: i64, ord: i64);
extern function lang_atomic_bool_swap(ptr: *u8, value: i64, ord: i64): i64;
