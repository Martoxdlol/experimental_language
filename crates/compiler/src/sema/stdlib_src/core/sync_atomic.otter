extend AtomicBool {
  function new(v: bool): AtomicBool {
    AtomicBool { ptr: lang_atomic_bool_new(__atomic_bool_code(v)) }
  }

  function load(self, ord: Ordering): bool {
    __atomic_bool_value(lang_atomic_bool_load(self.ptr, __atomic_load_order(ord)))
  }

  function store(self, v: bool, ord: Ordering): null {
    lang_atomic_bool_store(self.ptr, __atomic_bool_code(v), __atomic_store_order(ord));
    null
  }

  function swap(self, v: bool, ord: Ordering): bool {
    __atomic_bool_value(lang_atomic_bool_swap(
        self.ptr,
        __atomic_bool_code(v),
        __atomic_order_code(ord)
      ))
  }

  function compare_exchange(
    self,
    expected: bool,
    new: bool,
    success: Ordering,
    failure: Ordering
  ): bool {
    __atomic_bool_value(lang_atomic_bool_compare_exchange(
        self.ptr,
        __atomic_bool_code(expected),
        __atomic_bool_code(new),
        __atomic_order_code(success),
        __atomic_failure_order(failure)
      ))
  }

  function fetch_and(self, v: bool, ord: Ordering): bool {
    __atomic_bool_value(lang_atomic_bool_fetch_and(
        self.ptr,
        __atomic_bool_code(v),
        __atomic_order_code(ord)
      ))
  }

  function fetch_or(self, v: bool, ord: Ordering): bool {
    __atomic_bool_value(lang_atomic_bool_fetch_or(
        self.ptr,
        __atomic_bool_code(v),
        __atomic_order_code(ord)
      ))
  }

  function fetch_xor(self, v: bool, ord: Ordering): bool {
    __atomic_bool_value(lang_atomic_bool_fetch_xor(
        self.ptr,
        __atomic_bool_code(v),
        __atomic_order_code(ord)
      ))
  }
}

