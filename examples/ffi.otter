// Foreign Function Interface — extern structs, raw pointers, layout decorators
// (docs/19). Run: otter_fusion run examples/ffi.otter
//
// Three concerns kept separate: LAYOUT via `extern struct` (+ @Packed/@Align/
// @Union), the ABI via `extern function`, and crossing the boundary with raw
// pointers `*T`, address-of `&`, and dereference `*p`.

// An extern struct is C-laid-out and header-less; it lives on the stack.
import { println } from "std:io";

import { Foreign, CString, CStr, Buffer } from "core:ffi";
extern struct Pair { a: i64, b: i64 }

// A C function called across the ABI by its real symbol name. `memcpy` fills a
// destination through an out-pointer. `@CallConv` selects the calling
// convention (default "c"); on 64-bit targets "c"/"system"/"stdcall"/"fastcall"
// all coincide with the platform C ABI (docs/19 §7).
@CallConv("c")
extern function memcpy(dst: *u8, src: *u8, n: u64): *u8;

// @Union overlays all fields at offset 0 — read the bits of a float as a u32.
@Union
extern struct FloatBits { f: f32, i: u32 }

// @Packed caps field alignment (here `y` sits right after `x`, at offset 1).
@Packed
extern struct Packed { x: u8, y: u32 }

// @Align over-aligns the whole struct (cache-line padding etc.).
@Align(64)
extern struct CacheLine { v: i64 }

// A fixed-size array `[T; N]` is allowed only as an extern struct field (or an
// extern function parameter) — there are no general-purpose arrays elsewhere.
extern struct Sockaddr { family: u16, data: [u8; 14] }

// `*T | null` is laid out as a single raw nullable pointer (NPO) — no box. C
// functions that can fail (like `malloc`) return it; an `if p is null` check
// narrows it to `*T`.
extern function malloc(n: usize): *Sockaddr | null;
extern function free(p: *Sockaddr);

// Strings cross the boundary as NUL-terminated C strings.
extern function strlen(s: *u8): u64;

// A nested extern struct field is laid out inline (its bytes, not a pointer).
extern struct Timeval { sec: i64, usec: i64 }
extern struct Usage { utime: Timeval, stime: Timeval, maxrss: i64 }

// A @Transparent newtype has its field's representation + ABI (no box), so it
// can cross the C boundary as that field's type.
@Transparent
struct Count(i32)
extern function abs(n: Count): i32;

function main() {
  // `&value` is the address of the stack-allocated struct (no pin needed for a
  // stack value); a C function writes into it via the out-pointer.
  var src = Pair { a: 111, b: 222 };
  var dst = Pair { a: 0, b: 0 };
  memcpy((&dst) as *u8, (&src) as *u8, 16u64);
  println("copied: a=${dst.a} b=${dst.b}");

  // Field mutation writes back into the same block.
  dst.a = 999;
  println("mutated: a=${dst.a}");

  // A raw pointer reinterpret aliases the first field as a scalar; `*p` reads
  // and `*p = v` writes through the pointer.
  var pi = (&dst) as *i64;
  println("via *p: ${*pi}");
  *pi = 7;
  println("after *p = 7: a=${dst.a}");

  // @Union: write the float, read the IEEE-754 bits.
  var fb = FloatBits { f: 1.0f32 };
  println("bits of 1.0f32 = ${fb.i}");

  // @Packed vs natural layout, observed over identical source bytes.
  var bytes = Pair { a: 0x0807060504030201, b: 0 };
  var p = Packed { x: 0, y: 0 };
  memcpy((&p) as *u8, (&bytes) as *u8, 8u64);
  println("packed y (offset 1) = ${p.y}");

  // @Align(64): the address is a multiple of 64.
  var c = CacheLine { v: 0 };
  println("cache line 64-aligned: ${((&c) as usize) % 64usize == 0usize}");

  // A fixed-size array field `[T; N]` (only valid in extern positions). An
  // omitted field zero-inits the whole C block; `arr[i]` reads/writes elements;
  // `&arr[i]` is the address of an element, fillable by a C function.
  var buf = Sockaddr { family: 2u16 };
  buf.data[0] = 10u8;
  buf.data[1] = 0u8;
  buf.data[2] = 0u8;
  buf.data[3] = 1u8;
  println("sockaddr: family=${buf.family} ${buf.data[0]}.${buf.data[1]}.${buf.data[2]}.${buf.data[3]}");
  memcpy((&buf.data[4]) as *u8, (&bytes) as *u8, 4u64);
  println("after memcpy into &data[4]: ${buf.data[4]} ${buf.data[5]} ${buf.data[6]} ${buf.data[7]}");

  // A nullable pointer from C: `malloc` returns `*Sockaddr | null` (NPO, a raw
  // pointer); narrow it with `if p is null`.
  var heap = malloc(16usize);
  if heap is null {
    println("malloc failed");
  } else {
    println("malloc ok: ${!(heap is null)}");
    free(heap);
  }

  // Manual foreign-heap allocation (`docs/19` §5): `Foreign.alloc<T>()` returns
  // a raw `*T | null`; write fields through `*p`, then `Foreign.free`.
  var cell = Foreign.alloc<Pair>();
  if cell is null {
    println("foreign alloc failed");
  } else {
    (*cell).a = 314;
    (*cell).b = 159;
    println("foreign cell: a=${(*cell).a} b=${(*cell).b}");
    Foreign.free(cell);
  }

  // String marshaling (`docs/19` §6). `CString` is an *owning* handle: it holds
  // a NUL-terminated foreign-heap copy of the `str` and frees it on scope exit
  // (it implements `Drop`) — no manual `Foreign.free`. Hand its raw `*u8` to C
  // with `as_ptr`; recover a managed `str` with `to_str`.
  var cs = CString.from_str("otter");
  println("strlen=${strlen(cs.as_ptr())} byte_len=${cs.byte_len()}");
  println("round-trip=${cs.to_str()}");

  // `CStr` is a *borrowed* NUL-terminated view over a `*u8` the caller keeps
  // alive — here the bytes `cs` owns. No allocation, no free.
  var view = CStr.from_ptr(cs.as_ptr());
  println("view=${view.to_str()} (len ${view.byte_len()})");

  // `Buffer` is an `extern struct { data: *u8, size: u64 }` (docs/18 §9): a
  // foreign-heap byte region with *manual* lifetime. `alloc` is fallible
  // (`Buffer | null` on OOM); `get`/`set` are bounds-checked; `free` releases it.
  var maybe = Buffer.alloc(4u64);
  if maybe is null {
    println("buffer alloc failed");
  } else {
    var buf = maybe as Buffer;
    buf.set(0u64, 79u8);                // 'O'
    buf.set(1u64, 75u8);                // 'K'
    var b0 = buf.get(0u64);
    var oob = buf.get(99u64);           // out of range → null
    println("buffer[0]=${if b0 is null { 0u8 } else { b0 as u8 }} oob_is_null=${oob is null} size=${buf.size}");
    buf.free();
  }

  // Nested extern structs are embedded inline (`docs/19` §3).
  var usage = Usage {
    utime: Timeval { sec: 3, usec: 140 },
    stime: Timeval { sec: 1, usec: 590 },
    maxrss: 4096,
  };
  println("utime=${usage.utime.sec}.${usage.utime.usec} maxrss=${usage.maxrss}");

  // @Transparent: `Count(-9)` is just an i32 across the C ABI.
  println("abs=${abs(Count(-9i32))}");
}
