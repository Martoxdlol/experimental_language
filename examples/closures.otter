// Closures (docs/09): anonymous functions that capture their environment. A
// closure value is a `(Params) => Ret` — a heap environment holding the
// captured values plus a pointer to the lifted function. They are first-class:
// stored in variables, passed to and returned from functions, kept in lists.

// Takes a closure as a parameter.
import { List } from "core:collections";
import { println } from "std:io";

function apply_twice(f: (i64) => i64, x: i64): i64 {
  f(f(x))
}

// Returns a closure that captures `by`.
function adder(by: i64): (i64) => i64 {
  (n: i64): i64 => n + by
}

// A plain named function — usable as a first-class value (`docs/09` §4), passed
// wherever a `(i64) => i64` is expected, exactly like a closure.
function triple(n: i64): i64 {
  n * 3
}

function main() {
  var inc = (n: i64): i64 => n + 1;
  println("inc(41)        = ${inc(41) }");
  println("apply_twice    = ${apply_twice(inc, 40) }");

  // Captures are by reference (docs/09 §7): mutations inside the closure are
  // visible to the outer scope. Primitives sit in a heap cell; reference types
  // share the same heap object.
  var scale = 3;
  var times = (n: i64): i64 => n * scale;
  println("times(14)      = ${times(14) }");

  var total = 0;
  [1, 2, 3].each { total = total + it; };
  println("each total     = ${total}");   // 6

  // Capture a heap string.
  var prefix = ">> ";
  var shout = (s: str): str => prefix + s;
  println(shout("hello"));

  // Higher-order: build specialized closures.
  var add10 = adder(10);
  println("add10(5)       = ${add10(5) }");

  // A list of closures, applied in a loop.
  var ops: List<(i64) => i64> = [adder(1), adder(10), adder(100)];
  var total = 0;
  for op in ops {
    total = total + op(0);
  }
  println("sum of adders  = ${total}");   // 1 + 10 + 100 = 111

  // Higher-order List methods with the trailing-closure + implicit `it` sugar.
  var nums = [1, 2, 3, 4, 5, 6];
  var squares = nums.map { it * it };
  var bigs = squares.filter { it > 10 };
  var sum = bigs.fold(0, (acc: i64, x: i64): i64 => acc + x);
  println("squares > 10   = ${sum}");      // 16 + 25 + 36 = 77

  // `each` runs a closure for its side effects.
  var labels: List<str> = ["x", "y", "z"];
  labels.each { println("label: " + it); };

  // A named function is a first-class value: bind it, pass it, map with it.
  var f = triple;
  println("triple(7)      = ${f(7)}");                 // 21
  println("apply_twice    = ${apply_twice(triple, 2)}"); // triple(triple(2)) = 18
  var tripled = nums.map(triple);
  println("nums tripled   = ${tripled.fold(0, (a: i64, b: i64): i64 => a + b)}"); // 63
}
