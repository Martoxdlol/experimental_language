// Threads (docs/20 §1): isolated OS threads via `Thread.spawn`, joined for
// their results. A spawned closure runs on a fresh thread; `join` blocks until
// it finishes and yields `Joined<R> | Panicked`.
//
// Captures are by value and (for now) must be immutable, so each thread works
// from its own copy — the language's "no implicit sharing" rule (docs/20 §6).

function sum_to(n: i64): i64 {
  var acc: i64 = 0;
  var i: i64 = 0;
  while i < n {
    acc = acc + i;
    i = i + 1;
  }
  acc
}

function result_of(r: Joined<i64> | Panicked): i64 {
  match r {
    Joined<i64> j => j.value,
    Panicked p => 0 - 1,
  }
}

function main() {
  // Spawn three workers; each computes independently on its own thread.
  var a: JoinHandle<i64> = Thread.spawn(() => sum_to(1000));
  var b: JoinHandle<i64> = Thread.spawn(() => sum_to(2000));
  var c: JoinHandle<i64> = Thread.spawn(() => sum_to(3000));

  // Join collects the results back on the main thread (each handle once).
  var ra: i64 = result_of(a.join());
  var rb: i64 = result_of(b.join());
  var rc: i64 = result_of(c.join());
  println("worker a (sum 0..1000) = " + (ra as str));
  println("worker b (sum 0..2000) = " + (rb as str));
  println("worker c (sum 0..3000) = " + (rc as str));
  println("total = " + ((ra + rb + rc) as str));
}
