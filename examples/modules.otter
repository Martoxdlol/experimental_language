// Multi-file modules (docs/17): `mod` loads a sibling file, `import` brings
// its public names into scope. Run with `lang run examples/modules.lang` or
// build a native binary with `lang build examples/modules.lang`.
//
// File layout:
//   modules.lang              (this entry — the crate root)
//   modules/geometry.lang     (mod geometry;)
//   modules/geometry/vec.lang (mod vec; inside geometry)

mod geometry;

import { Rect, area } from "geometry";
import { Vec2, length_sq } from "geometry/vec";

function main() {
  var r: Rect = Rect { w: 6, h: 7 };
  println("area = ${area(r)}");

  var v: Vec2 = Vec2 { x: 3, y: 4 };
  println("|v|^2 = ${length_sq(v)}");
}
