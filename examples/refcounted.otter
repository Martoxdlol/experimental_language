import { Future } from "core:prelude";
// @RefCounted (docs/16 §8.1): opt a struct into deterministic, atomic reference
// counting. Unlike ordinary managed objects — whose `Drop` is best-effort and
// GC-timed — a `@RefCounted` value's `drop(self)` runs immediately as
// non-waiting cleanup when its last strong reference goes away, with the
// tracing GC kept only as the cycle-collector backstop (reference counting
// alone leaks cycles).
//
// Assignment SHARES (retains); `.clone()` makes an independent deep copy. The
// strong count is atomic, so a refcounted handle can cross threads.

import { println } from "std:io";
import { Drop } from "core:prelude";
import { AtomicI64, SeqCst } from "core:sync/atomic";

@RefCounted
struct Resource { id: i64, events: AtomicI64 }

extend Resource: Drop {
  // Deterministic finalization: runs at strong-count 0, before the memory is freed.
  function drop(self) { record(self.events, self.id); }
}

// A @RefCounted owner releases its @RefCounted fields when it is destroyed, so
// destruction cascades through the owned graph (owner drops first).
@RefCounted
struct Session { log: Resource, events: AtomicI64 }
extend Session: Drop { function drop(self) { record(self.events, 9); } }

function record(events: AtomicI64, code: i64): null {
  var prior = events.load(SeqCst {});
  events.store((prior * 1000) + code, SeqCst {});
  null
}

function acquire(id: i64, events: AtomicI64): Resource { Resource { id: id, events: events } } // factory: hands back an owned reference

function scenario(events: AtomicI64): Future<null> async {
  // Deterministic scope-bound drop, reverse binding order.
  var a: Resource = acquire(1, events);
  var b: Resource = a; // shared: both name the same resource; it finalizes once
  await println("acquired ${b.id}");

  // Reassignment releases the previous value immediately.
  var c: Resource = acquire(2, events);
  c = acquire(3, events); // records release of resource 2 here

  // Ownership cascade: the session owns its log resource.
  var s: Session = Session { log: acquire(4, events), events: events };
  await println("working");
  // Scope exit (reverse order): session (end + release 4), then c (3), then a/b (1).
  null
}

function main(): Future<null> async {
  var events = AtomicI64.new(0);
  await scenario(events);
  await println("release_order=${events.load(SeqCst {})}");
  null
}
