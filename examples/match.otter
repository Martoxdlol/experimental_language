import { Future } from "core:prelude";
// Discriminated unions + match. Run: lang run examples/match.lang
import { println } from "std:io";

struct Circle { radius: f64 }
struct Rect { w: f64, h: f64 }
type Shape = Circle | Rect;

function area(s: Shape): f64 {
  match s {
    Circle c => 3.14159 * c.radius * c.radius,
    Rect r => r.w * r.h,
  }
}

// Destructuring patterns bind a variant's fields directly: `Circle { radius }`
// (record) pulls the field out without a separate `.field` access.
function perimeter(s: Shape): f64 {
  match s {
    Circle { radius } => 2.0 * 3.14159 * radius,
    Rect { w, h } => 2.0 * (w + h),
  }
}

function describe(x: i64 | str | null): str {
  match x {
    i64 n => "int " + (n as str),
    str s => "string " + s,
    null => "nothing",
  }
}

function main(): Future<null> async {
  await println("circle area = " + (area(Circle { radius: 2.0 }) as str));
  await println("rect area = " + (area(Rect { w: 3.0, h: 4.0 }) as str));
  await println("circle perim = " + (perimeter(Circle { radius: 2.0 }) as str));
  await println("rect perim = " + (perimeter(Rect { w: 3.0, h: 4.0 }) as str));
  await println(describe(42));
  await println(describe("hello"));
  await println(describe(null));
  null
}
