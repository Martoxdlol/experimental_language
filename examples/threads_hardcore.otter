import { List } from "core:collections";
import { Future } from "core:async";
import { JoinHandle } from "std:thread";

import { Thread } from "std:thread";

// CPU-heavy work can use one OS thread per worker. This example intentionally
// uses Thread.spawn rather than Task.spawn so executor workers stay available
// for lightweight async tasks and explicit async I/O.
function hard_work(n: i64): i64 {
  var acc: i64 = 0;
  var i: i64 = 0;
  while i < n {
    acc = acc + i;
    i = i + 1;
  }
  acc
}

function main(): Future<null> async {
  var handles: List<JoinHandle<i64>> = [];

  var count = 1;

  var i: i64 = 0;
  while i < count {
    var handle: JoinHandle<i64> = Thread.spawn(() => hard_work(100000000));
    handles.push(handle);
    i = i + 1;
  }

  for handle in handles {
    await handle.join();
  }
}
