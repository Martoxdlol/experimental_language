// Shared<T> (docs/20 §4): an explicit ASYNC mutex for genuinely shared mutable
// state. `Shared.new(value)` wraps a value; `lock`/`try_lock` are async — you
// `await` them — and run a closure with exclusive access; clones of the handle
// all lock the same cell. Acquiring a contended lock suspends the task (never
// the OS thread); the lock is fair (FIFO) and not reentrant.

import { println } from "std:io";
import { Future } from "core:async";
import { Shared, LockBusy } from "std:sync";

struct Counter { value: i64 }

// Lock-using workers must be async (`lock` is `await`-only), so this is an
// `async` function driven by the `spawn` keyword (docs/20 §1/§4, docs/21).
function bump(s: Shared<Counter>, times: i64): Future < null > async {
  var i: i64 = 0;
  while i < times {
    // Exclusive access inside the body; the struct is mutated in place. The
    // mutex serializes contending tasks, so no increment is lost.
    await s.lock((c) => { c.value = c.value + 1; 0 });
    i = i + 1;
  }
}

// An async `main` so we can `await` the lock and each worker without parking
// the OS thread (docs/21).
function main(): Future < null > async {
  var state: Shared<Counter> = Shared.new(Counter { value: 0 });

  // `clone` clones the *handle* — both workers lock the same counter.
  var a: Shared<Counter> = state.clone();
  var b: Shared<Counter> = state.clone();
  // `spawn` schedules each async worker on the executor, yielding a Future.
  var h1: Future < null > = spawn bump(a, 5000);
  var h2: Future < null > = spawn bump(b, 5000);
  // Awaiting each spawn handle suspends the joiner task until the worker ends.
  await h1;
  await h2;

  // No lost updates: the mutex serialized every increment.
  var total: i64 = await state.lock((c) => c.value);
  println("counter after 2x5000 increments = " + (total as str));

  // `try_lock` returns `R | LockBusy` without suspending on a contended lock.
  match await state.try_lock((c) => c.value) {
    i64 n => println("snapshot = " + (n as str)),
    LockBusy busy => println("was busy"),
  }
}
