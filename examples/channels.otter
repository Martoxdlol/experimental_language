import { Future } from "core:prelude";
// Channels (docs/20 §2) are deterministically closeable. `channel<T>()`
// returns a `(Sender<T>, Receiver<T>)` pair; `send` enqueues without blocking,
// `recv()` is the single-message async receive path, and `for await` over a
// receiver awaits each message without parking an executor worker.
//
// The channel CLOSES when its last `Sender` is dropped. For these runtime
// endpoint handles that drop is *deterministic and scope-bound* (docs/16 §8):
// a `Sender` captured into a worker is released the instant the worker returns,
// without waiting for a garbage collection. Once closed and drained, `recv()`
// resolves to `ChannelClosed` and `for await x in rx` terminates. Endpoints are
// thread-safe, so a `Sender` can be captured into a spawned worker; cloning one
// makes another producer.

import { println } from "std:io";
import { JoinHandle } from "std:thread";
import { Sender, Receiver, ChannelClosed } from "std:sync";
import { channel } from "std:sync";
import { Thread } from "std:thread";

// A producer sends the squares 1, 4, 9, ... then returns. The `Sender` it
// captured is released on return — when the last sender goes, the channel
// closes and the consumer's loop ends.
function produce(tx: Sender<i64>, n: i64) {
  var i: i64 = 1;
  while i <= n {
    tx.send(i * i); // non-blocking; returns `null | ChannelClosed`
    i = i + 1;
  }
}

// A consumer drains with `for await sq in rx`: the loop awaits each message and
// terminates once the channel is closed and drained — no GC needed.
function consume(rx: Receiver<i64>): Future<i64> async {
  var total: i64 = 0;
  for await sq in rx {
    total = total + sq;
  }
  total
}

function main(): Future<null> async {
  var pair: (Sender<i64>, Receiver<i64>) = channel<i64>();
  var tx: Sender<i64> = pair.0;
  var rx: Receiver<i64> = pair.1;

  // The worker produces on its own thread; capturing `tx` moves the producer
  // role into the worker, which releases it on return (closing the channel).
  var worker: JoinHandle<i64> = Thread.spawn(() => { produce(tx, 5); 0 });

  var total: i64 = await consume(rx);
  await println("sum of squares 1..5 = " + (total as str)); // 1+4+9+16+25 = 55

  // The channel is now drained and closed; a non-blocking poll sees nothing.
  match rx.try_recv() {
    i64 n => await println("unexpected: " + (n as str)),
    null => await println("channel drained and closed"),
  }
  null
}
