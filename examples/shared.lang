// Shared<T> (docs/20 §4): an explicit mutex for genuinely shared mutable state.
// `Shared.new(value)` wraps a value; `lock` runs a closure with exclusive
// access; clones of the handle all lock the same cell. Not reentrant.

struct Counter { value: i64 }

function bump(s: Shared<Counter>, times: i64) {
  var i: i64 = 0;
  while i < times {
    // Exclusive access inside the body; the struct is mutated in place.
    s.lock((c) => { c.value = c.value + 1; 0 });
    i = i + 1;
  }
}

function main() {
  var state: Shared<Counter> = Shared.new(Counter { value: 0 });

  // `clone` clones the *handle* — both workers lock the same counter.
  var a: Shared<Counter> = state.clone();
  var b: Shared<Counter> = state.clone();
  var h1: JoinHandle<i64> = Thread.spawn(() => { bump(a, 5000); 0 });
  var h2: JoinHandle<i64> = Thread.spawn(() => { bump(b, 5000); 0 });
  // `join()` is async (docs/20 §1 / docs/21); `block_on` drives the future
  // here rather than parking the calling OS thread.
  match block_on(h1.join()) { Joined<i64> j => {}, Panicked p => {} }
  match block_on(h2.join()) { Joined<i64> j => {}, Panicked p => {} }

  // No lost updates: the mutex serialized every increment.
  var total: i64 = state.lock((c) => c.value);
  println("counter after 2x5000 increments = " + (total as str));

  // `try_lock` returns `R | LockBusy` without blocking.
  match state.try_lock((c) => c.value) {
    i64 n => println("snapshot = " + (n as str)),
    LockBusy busy => println("was busy"),
  }
}
