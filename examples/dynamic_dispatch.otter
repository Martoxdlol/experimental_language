import { Future } from "core:prelude";
// Interface objects (docs/11 §5): using an interface *name* as a value type
// (a var, parameter, field, or list element) creates an interface object — a
// fat pointer of {vtable, data}. Method calls dispatch dynamically through the
// vtable, so values of different concrete types share one static type.

import { List } from "core:collections";
import { println } from "std:io";

interface Shape {
  function area(self): i64;
  function name(self): str;
}

struct Square { side: i64 }
struct Rect { w: i64, h: i64 }

extend Square: Shape {
  function area(self): i64 { self.side * self.side }
  function name(self): str { "square" }
}

extend Rect: Shape {
  function area(self): i64 { self.w * self.h }
  function name(self): str { "rect" }
}

// A function over the interface type accepts any implementor.
function describe(s: Shape): str {
  s.name() + " has area " + (s.area() as str)
}

function main(): Future<null> async {
  var a: Shape = Square { side: 5 };
  var b: Shape = Rect { w: 3, h: 4 };
  await println(describe(a));
  await println(describe(b));

  // A heterogeneous collection of interface objects.
  var shapes: List<Shape> = [Square { side: 2 }, Rect { w: 10, h: 2 }, Square { side: 3 }];
  var total = 0;
  for s in shapes {
    total = total + s.area();
  }
  await println("total area = ${total}");   // 4 + 20 + 9 = 33

  // `is`/`as` recover the concrete type from an interface object.
  if a is Square {
    var sq = a as Square;
    await println("a is a square of side ${sq.side}");
  }
  await println("b is a square: ${b is Square}");   // false
  null
}
