// Async / await (docs/21) — JavaScript/Dart-style.
//
// An `async` function declares its return type as `Future<Output>`. Calling
// it does NOT run the body — it returns an inert state-machine future.
// `await` drives a future inside another async body; the compiler turns the
// surrounding body into a state machine that suspends at each `await`
// (returning `Pending`) and resumes when the awaited future is ready.
//
// `main` itself can be `async`: the runtime detects this and drives the root
// future automatically — there is no user-visible `block_on`.
// `spawn EXPR` schedules a future on a worker; it itself evaluates to a
// `Future<T>`, so `var f = spawn task(); var v = await f` runs `task` in
// parallel and joins it.
//
// Calling an `async` function and discarding the result is an error: a
// `Future` that is never `await`ed, `spawn`ed, or bound (`var f = …` or
// `var _ = …`) is a forgot-to-await mistake (docs/21 §5).

// An async function. The body's trailing value is the future's Output.
function answer(): Future<i64> async {
  40 + 2
}

// A managed (str) Output works too; it survives GC across the poll machinery.
function greet(name: str): Future<str> async {
  "hello, " + name
}

// An async stream: `AsyncIterator<T>` whose `next_async` yields then produces.
struct Range { current: i64, end: i64 }

extend Range: AsyncIterator<i64> {
  function next_async(self): Future<Item<i64> | Done> {
    async {
      if self.current >= self.end {
        Done {}
      } else {
        var _ = await sleep(1);
        var v: i64 = self.current;
        self.current = self.current + 1;
        Item { value: v }
      }
    }
  }
}

function sum_range(r: Range): Future<i64> async {
  var total: i64 = 0;
  for await n in r {
    total = total + n;
  }
  total
}

// `await` chains futures. `compute` awaits two inner futures and combines them.
function compute(): Future<i64> async {
  var a: i64 = await answer();
  var b: i64 = await greet_len("world");
  a + b
}

function greet_len(name: str): Future<i64> async {
  var g: str = await greet(name);
  g.size()
}

// A genuinely-suspending future: `yield_now()` returns Pending once. Looping
// over it suspends and resumes the state machine repeatedly.
function tick(n: i64): Future<i64> async {
  var sum: i64 = 0;
  var i: i64 = 0;
  while i < n {
    var _ = await yield_now();
    sum = sum + i;
    i = i + 1;
  }
  sum
}

// The program entry is itself an async function — the runtime starts the
// executor and drives this future to completion. No `block_on` in user code.
function main(): Future<null> async {
  // Drive an async function directly with `await`.
  var a: i64 = await answer();
  println("answer = ${a}");

  var g: str = await greet("async world");
  println(g);

  // A bare `async { … }` block is a zero-arg inline future literal. It
  // captures enclosing locals by value.
  var base: i64 = 100;
  var computed: i64 = await async { base + 42 };
  println("computed = ${computed}");

  // `await` chaining: answer() = 42, greet_len("world") = len("hello, world") = 12.
  var c: i64 = await compute();
  println("compute = ${c}");

  // Genuine suspension: 0 + 1 + 2 + 3 = 6, across four park/resume cycles.
  var t: i64 = await tick(4);
  println("tick = ${t}");

  // `for await` over an async stream: 0 + 1 + 2 + 3 + 4 = 10.
  var r = Range { current: 0, end: 5 };
  var s: i64 = await sum_range(r);
  println("stream = ${s}");

  // `spawn EXPR` schedules a future on a worker and itself returns a
  // `Future<T>`. We can run two tasks in parallel and `await` each in turn.
  var h: Future<i64> = spawn tick(5);
  var spawned: i64 = await h;
  println("spawned = ${spawned}");
}
