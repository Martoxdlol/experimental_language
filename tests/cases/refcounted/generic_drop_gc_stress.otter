//@ kind: run
//@ env: OTTER_FUSION_GC=stress
//@ description: generic `@RefCounted` Drop type drops deterministically per loop iteration even under aggressive GC (collect on every allocation) — the per-instance finalizer is correctly registered for each monomorphization and the determinism boundary (docs/16 §8.1) holds.
//@ stdout:
//~ iter 0
//~ iter 1
//~ done
//~ drops=1002
import { Future } from "core:prelude";
import { println } from "std:io";
import { Drop } from "core:prelude";
import { AtomicI64, SeqCst } from "core:sync/atomic";

@RefCounted
struct Res<T> { value: T, tag: i64, events: AtomicI64 }

extend<T> Res<T>: Drop {
  function drop(self) { record(self.events, self.tag + 1); }
}

function record(events: AtomicI64, code: i64): null {
  var prior = events.load(SeqCst {});
  events.store((prior * 1000) + code, SeqCst {});
  null
}

function one(id: i64, events: AtomicI64): Future<null> async {
  var r: Res<i64> = Res<i64> { value: 0, tag: id, events: events };
  await println("iter ${id}");
  null
}

function scenario(events: AtomicI64): Future<null> async {
  var i: i64 = 0;
  while i < 2 {
    await one(i, events);
    i = i + 1;
  }
  await println("done");
  null
}

function main(): Future<null> async {
  var events = AtomicI64.new(0);
  await scenario(events);
  await println("drops=${events.load(SeqCst {})}");
  null
}
