//@ kind: run
//@ env: OTTER_FUSION_GC=stress
//@ description: a @RefCounted value stored in a GC collection stays alive while referenced (no use-after-free); reclaimed by the GC backstop
//@ stdout:
//~ len 3
//~ first 0
//~ sum 3
import { Future } from "core:prelude";
import { println } from "std:io";
import { List } from "core:collections";

@RefCounted
struct R { id: i64 }

function main(): Future<null> async {
  var xs: List<R> = [];
  var i: i64 = 0;
  while i < 3 {
    var r: R = R { id: i };   // a local owner that goes out of scope each iteration ...
    xs.push(r);               // ... but the list keeps it alive (retain on store)
    i = i + 1;
  }
  await println("len ${xs.size()}");
  await println("first ${xs[0].id}");   // safe read — not freed despite the local being gone
  var sum: i64 = 0;
  var k: i64 = 0;
  while k < xs.size() { sum = sum + xs[k].id; k = k + 1; }
  await println("sum ${sum}");
  null
}
