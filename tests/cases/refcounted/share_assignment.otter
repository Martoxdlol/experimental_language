//@ kind: run
//@ description: assignment shares a @RefCounted value (retain); the object drops once
//@ stdout:
//~ shared
//~ drops=10
import { Future } from "core:prelude";
import { println } from "std:io";
import { Drop } from "core:prelude";
import { AtomicI64, SeqCst } from "core:sync/atomic";

@RefCounted
struct Res { id: i64, events: AtomicI64 }
extend Res: Drop { function drop(self) { record(self.events, self.id); } }

function record(events: AtomicI64, code: i64): null {
  var prior = events.load(SeqCst {});
  events.store((prior * 1000) + code, SeqCst {});
  null
}

function scenario(events: AtomicI64): Future<null> async {
  var a: Res = Res { id: 10, events: events };
  var b: Res = a;          // shared: retain — two bindings, one object
  await println("shared");
  null
}

function main(): Future<null> async {
  var events = AtomicI64.new(0);
  await scenario(events);
  await println("drops=${events.load(SeqCst {})}");
  null
}
