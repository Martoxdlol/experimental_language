//@ kind: run
//@ description: two @RefCounted owners share a child; the child drops once, after the last owner
//@ stdout:
//~ built
//~ drops=2001009
import { Future } from "core:prelude";
import { println } from "std:io";
import { Drop } from "core:prelude";
import { AtomicI64, SeqCst } from "core:sync/atomic";
@RefCounted
struct Child { id: i64, events: AtomicI64 }
extend Child: Drop { function drop(self) { record(self.events, 9); } }
@RefCounted
struct Parent { id: i64, child: Child, events: AtomicI64 }
extend Parent: Drop { function drop(self) { record(self.events, self.id); } }
function record(events: AtomicI64, code: i64): null {
  var prior = events.load(SeqCst {});
  events.store((prior * 1000) + code, SeqCst {});
  null
}
function scenario(events: AtomicI64): Future<null> async {
  var c: Child = Child { id: 0, events: events };
  var p1: Parent = Parent { id: 1, child: c, events: events };
  var p2: Parent = Parent { id: 2, child: c, events: events };
  await println("built");
  null
}
function main(): Future<null> async {
  var events = AtomicI64.new(0);
  await scenario(events);
  await println("drops=${events.load(SeqCst {})}");
  null
}
