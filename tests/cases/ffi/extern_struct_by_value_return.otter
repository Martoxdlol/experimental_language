//@ kind: run
//@ description: docs/19 §3 — returning an extern struct by value works; the value is copied to a managed heap block so it does not dangle past the callee frame
//@ stdout:
//~ 11 22
//~ 7 14
import { Future } from "core:prelude";
import { println } from "std:io";
extern struct Pair { a: i64, b: i64 }
function make(x: i64, y: i64): Pair { Pair { a: x, b: y } }
function main(): Future<null> async {
  var p = make(11, 22);
  await println("${p.a} ${p.b}");
  var q = make(7, 14);
  await println("${q.a} ${q.b}");
  null
}
