//@ kind: run
//@ description: docs/19 §6 — CString is @RefCounted and frees its foreign buffer deterministically on scope exit (Drop); lang_foreign_outstanding tracks the live foreign-block count
//@ stdout:
//~ after scope leak=0
//~ two live=2
import { Future } from "core:prelude";
import { println } from "std:io";
import { CString } from "core:ffi";
extern function lang_foreign_outstanding(): i64;
function scope() { var cs = CString.from_str("freed on scope exit"); }
function main(): Future<null> async {
  var base = lang_foreign_outstanding();
  scope();
  // The CString in `scope` dropped at its scope exit, freeing its buffer.
  await println("after scope leak=${lang_foreign_outstanding() - base}");
  var a = CString.from_str("a");
  var b = CString.from_str("b");
  await println("two live=${lang_foreign_outstanding() - base}");
  null
}
