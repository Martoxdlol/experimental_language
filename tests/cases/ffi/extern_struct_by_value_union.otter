//@ kind: run
//@ description: docs/19 §3 — a by-value extern struct boxed into a non-NPO union (Pt|null) round-trips correctly; its 16 bytes are copied to the managed heap, not truncated to a dangling stack pointer
//@ stdout:
//~ a=5,10
//~ b null
import { Future } from "core:prelude";
import { println } from "std:io";
extern struct Pt { x: i64, y: i64 }
function pick(n: i64): Pt | null {
  if n < 0 { null } else { Pt { x: n, y: n * 2 } }
}
function main(): Future<null> async {
  var a = pick(5);
  var b = pick(-1);
  if a is null { await println("a null"); } else { var p = a as Pt; await println("a=${p.x},${p.y}"); }
  if b is null { await println("b null"); } else { await println("b not null"); }
  null
}
