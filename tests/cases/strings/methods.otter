//@ kind: run
//@ description: core str methods
//@ stdout:
//~ 5
//~ true
//~ true
//~ true
//~ ELLO
//~ hello
//~ trimmed
import { Future } from "core:prelude";
import { println } from "std:io";
function main(): Future<null> async {
  var s = "hello";
  await println("${s.size()}");
  await println("${s.contains("ell")}");
  await println("${s.starts_with("he")}");
  await println("${s.ends_with("lo")}");
  await println("${"hello".substring(1, 5).to_upper()}");
  await println("${"HELLO".to_lower()}");
  await println("${"  trimmed  ".trim()}");
  null
}
