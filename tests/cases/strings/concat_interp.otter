//@ kind: run
//@ description: string concatenation and interpolation
//@ stdout:
//~ hello, world
//~ 1 + 2 = 3
//~ x=7 y=8
import { Future } from "core:prelude";
import { println } from "std:io";
function main(): Future<null> async {
  var who = "world";
  await println("hello, " + who);
  await println("1 + 2 = ${1 + 2}");
  var x = 7;
  var y = 8;
  await println("x=$x y=$y");
  null
}
