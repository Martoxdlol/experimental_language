//@ kind: run
//@ description: interface default method (docs/10) — an implementer that omits it inherits the default body; one that provides it overrides; both reached via dynamic dispatch
//@ stdout:
//~ Hello, world
//~ Bonjour, monde
import { Future } from "core:prelude";
import { println } from "std:io";
interface Greet {
  function name(self): str;
  function hello(self): str { "Hello, " + self.name() }
}
struct En {}
struct Fr {}
extend En: Greet { function name(self): str { "world" } }
extend Fr: Greet {
  function name(self): str { "monde" }
  function hello(self): str { "Bonjour, " + self.name() }
}
function main(): Future<null> async {
  var a: Greet = En {};
  var b: Greet = Fr {};
  await println(a.hello());
  await println(b.hello());
  null
}
