//@ kind: run
//@ description: `as str` stringifies primitives
//@ stdout:
//~ 42
//~ true
//~ 3.5
//~ z
import { Future } from "core:prelude";
import { println } from "std:io";
function main(): Future<null> async {
  await println(42 as str);
  await println(true as str);
  await println(3.5 as str);
  await println('z'as str);
  null
}
