//@ kind: run
//@ description: match literal patterns and guards
//@ stdout:
//~ one
//~ small
//~ big
import { Future } from "core:prelude";
import { println } from "std:io";
function name(n: i64): str {
  match n {
    1 => "one",
    n if n < 10 => "small",
    _ => "big",
  }
}
function main(): Future<null> async {
  await println(name(1));
  await println(name(5));
  await println(name(100));
  null
}
