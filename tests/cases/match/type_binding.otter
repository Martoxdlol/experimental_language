//@ kind: run
//@ description: match with type-binding arms over a union
//@ stdout:
//~ int 42
//~ string hi
//~ nothing
import { Future } from "core:prelude";
import { println } from "std:io";
function describe(x: i64 | str | null): str {
  match x {
    i64 n => "int " + (n as str),
    str s => "string " + s,
    null  => "nothing",
  }
}
function main(): Future<null> async {
  await println(describe(42));
  await println(describe("hi"));
  await println(describe(null));
  null
}
