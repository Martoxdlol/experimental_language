//@ kind: run
//@ serial
//@ description: timing out an AsyncUdpSocket receive removes the reactor wait and discards the late provider result
//@ stdout:
//~ udp-timeout=true keep 4 0 0

import { Future } from "core:prelude";
import { Bytes } from "std:bytes";
import { sleep, timeout, TimedOut } from "std:async";
import { println, IoError } from "std:io";
import { AsyncUdpSocket } from "std:net";
import { SocketAddr, ip_v4, socket_addr } from "std:net/types";

function trim_read_buffer(buf: Bytes, request_len: i64): Bytes {
  var i = 0;
  while i < request_len {
    var _ = buf.remove_at(0);
    i = i + 1;
  }
  buf
}

function decode_appended(buf: Bytes, request_len: i64): str {
  var decoded = trim_read_buffer(buf, request_len).decode_utf8();
  if decoded is str { decoded as str } else { "utf8-error" }
}

function filled_buffer(len: i64): Bytes {
  var buf = Bytes.new();
  var i = 0;
  while i < len {
    buf.push(0u8);
    i = i + 1;
  }
  buf
}

function recv_text(socket: AsyncUdpSocket, len: i64): Future<str> async {
  var buf = filled_buffer(len);
  var received = await socket.recv_from_async(buf);
  if received is IoError || (received as (i64, SocketAddr)).0 != len {
    "recv-error"
  } else {
    decode_appended(buf, len)
  }
}

function main(): Future<null> async {
  var bound_receiver = await AsyncUdpSocket.bind(socket_addr(ip_v4(127u8, 0u8, 0u8, 1u8), 0u16));
  var bound_sender = await AsyncUdpSocket.bind(socket_addr(ip_v4(127u8, 0u8, 0u8, 1u8), 0u16));
  if bound_receiver is IoError || bound_sender is IoError {
    await println("udp-timeout=false bind-error -1 -1 -1");
    return null;
  }

  var receiver = bound_receiver as AsyncUdpSocket;
  var sender = bound_sender as AsyncUdpSocket;
  var receiver_addr = await receiver.local_addr();
  if receiver_addr is IoError {
    await println("udp-timeout=false addr-error -1 -1 -1");
    return null;
  }

  var stale_buf = filled_buffer(4);
  var timed = await timeout(receiver.recv_from_async(stale_buf), 1);
  var timed_out = timed is TimedOut;

  var stale_sent = await sender.send_to_async(Bytes.from_str("drop"), receiver_addr as SocketAddr);
  var _settled = await sleep(10);
  var fresh_sent = await sender.send_to_async(Bytes.from_str("keep"), receiver_addr as SocketAddr);
  var fresh = await recv_text(receiver, 4);
  var close_sender = await sender.close();
  var close_receiver = await receiver.close();
  await println("udp-timeout=${timed_out} ${fresh} ${if fresh_sent is i64 { fresh_sent as i64 } else { -1 }} ${if close_sender is IoError { 1 } else { 0 }} ${if close_receiver is IoError { 1 } else { 0 }}");
  null
}
