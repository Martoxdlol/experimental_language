import { Map } from "core:collections";
import { SystemTime } from "std:time";

function make(level: Level): Record {
  Record {
    level: level,
    message: "x",
    module: "m",
    fields: Map.new<str, str>(),
    time: SystemTime.from_unix_nanos(0),
  }
}

function make_level_variants(): Level {
  var trace: Level = LogTrace {};
  var debug_level: Level = LogDebug {};
  var info_level: Level = Info {};
  var warn_level: Level = Warn {};
  var error_level: Level = LogError {};
  trace
}

function make_marker(): LoggerAlreadySet {
  LoggerAlreadySet {}
}

function accepts_logger(logger: Logger) {
  logger.enabled(level_info(), "module");
}

function main() {
  var fields = empty_fields();
  var rec = record(level_info(), "msg", "module", fields);
  level_trace();
  level_debug();
  level_info();
  level_warn();
  level_error();
  log_record(rec);
  trace("hello");
  debug("hello");
  info("hello");
  warn("hello");
  error("hello");
  info_with("info", fields);
  trace_with("trace", fields);
  debug_with("debug", fields);
  warn_with("warn", fields);
  error_with("error", fields);
}
