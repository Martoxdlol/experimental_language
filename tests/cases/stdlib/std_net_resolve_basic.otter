//@ kind: run
//@ description: std:net resolves host/IP names through the provider into std:net/types IP values
//@ stdout:
//~ resolve-v4=true 1 true 127.0.0.1
//~ resolve-bad=true true

import { List } from "core:collections";
import { IpAddr } from "std:net/types";
import { IoError } from "std:io";
import { resolve } from "std:net";
import { println } from "std:io";

function main() {
  var resolved = resolve("127.0.0.1");
  if resolved is List<IpAddr> {
    var addrs = resolved as List<IpAddr>;
    var first = addrs[0];
    println("resolve-v4=true ${addrs.size()} ${first.is_v4()} ${first.to_str()}");
  } else {
    println("resolve-v4=false 0 false none");
  }

  var bad = resolve("");
  if bad is IoError {
    println("resolve-bad=true ${(bad as IoError).message().size() > 0}");
  } else {
    println("resolve-bad=false false");
  }
}
