//@ kind: run
//@ description: std:fs exposes target-backed filesystem helpers plus async File descriptor setup and byte IO methods
//@ stdout:
//~ top=alpha-beta
//~ query=true true false true false true false false false
//~ meta=file 10 true false kind=file len=10 readonly=false
//~ dir_meta=directory true
//~ bytes=true bytes[0,255,65,66] true true
//~ file_io=4 2 bytes[0,255] 2 bytes[65,66] true true true true true
//~ mutate=true true true true true true true true true
//~ canon=true true true
//~ read_dir=true true true
//~ file=alpha-beta path=/tmp/otter_fusion_std_fs_text_basic.txt append=false
//~ overwrite=reset
//~ append_mode=true after=reset+tail close=true
//~ open_options=true true opts+more true true OpenOptions(read=true, write=true, append=false, truncate=true, create=true, create_new=false)
//~ open_options_validate=true true true filesystem open options must enable read, write, or append true filesystem open options using create require write or append access
//~ missing=true
import { Future } from "core:prelude";
import { println } from "std:io";
import { Bytes } from "std:bytes";
import { DirEntries, DirEntry, File, FileKind, Metadata, OpenOptions, Path, Permissions, append_string, canonicalize, create_dir, create_dir_all, open_options, read_dir, read_to_string, remove, rename, write_string } from "std:fs";
import { read, write } from "std:fs";
import { End, IoError, Start } from "std:io";

function main(): Future<null> async {
  var path = Path.new("/tmp/otter_fusion_std_fs_text_basic.txt");
  var missing_path = Path.new("/tmp/otter_fusion_std_fs_text_missing_never_exists.txt");
  var bytes_path = Path.new("/tmp/otter_fusion_std_fs_bytes_basic.bin");

  var wrote = await write_string(path, "alpha");
  if wrote is null {
    var appended = await append_string(path, "-beta");
    if appended is null {
      var text = await read_to_string(path);
      if text is str {
        await println("top=${text as str}");
      }
    }
  }

  var path_exists = await path.exists();
  var path_is_file = await path.is_file();
  var path_is_dir = await path.is_dir();
  var tmp = Path.new("/tmp");
  var tmp_exists = await tmp.exists();
  var tmp_is_file = await tmp.is_file();
  var tmp_is_dir = await tmp.is_dir();
  var missing_exists = await missing_path.exists();
  var missing_is_file = await missing_path.is_file();
  var missing_is_dir = await missing_path.is_dir();
  if path_exists is bool && path_is_file is bool && path_is_dir is bool &&
    tmp_exists is bool && tmp_is_file is bool && tmp_is_dir is bool &&
    missing_exists is bool && missing_is_file is bool && missing_is_dir is bool {
    await println("query=${path_exists as bool} ${path_is_file as bool} ${path_is_dir as bool} ${tmp_exists as bool} ${tmp_is_file as bool} ${tmp_is_dir as bool} ${missing_exists as bool} ${missing_is_file as bool} ${missing_is_dir as bool}");
  }

  var meta = await path.metadata();
  var kind = await path.file_kind();
  var len = await path.byte_len();
  var perms = await path.permissions();
  if meta is Metadata && kind is FileKind && len is u64 && perms is Permissions {
    var m = meta as Metadata;
    var p = perms as Permissions;
    await println("meta=${m.file_kind().to_str()} ${m.len()} ${m.is_file()} ${m.is_dir()} kind=${(kind as FileKind).to_str()} len=${len as u64} readonly=${p.is_read_only()}");
  }

  var cwd_meta = await Path.new(".").metadata();
  if cwd_meta is Metadata {
    var m = cwd_meta as Metadata;
    await println("dir_meta=${m.file_kind().to_str()} ${m.is_dir()}");
  }

  var binary = Bytes.new();
  binary.push(0u8);
  binary.push(255u8);
  binary.push(65u8);
  binary.push(66u8);
  var wrote_bytes = await write(bytes_path, binary);
  var read_bytes = await read(bytes_path);
  var missing_bytes = await read(bytes_path.join("missing"));
  if read_bytes is Bytes {
    await println("bytes=${wrote_bytes is null} ${(read_bytes as Bytes).to_str()} ${(read_bytes as Bytes) == binary} ${missing_bytes is IoError}");
  }
  await remove(bytes_path);

  var file_io_path = Path.new("/tmp/otter_fusion_std_fs_file_io.bin");
  await remove(file_io_path);
  var handle_file = await File.create(file_io_path);
  if handle_file is File {
    var f = handle_file as File;
    var write_count = await f.write(binary);
    var flushed = await f.flush();
    var seek_start = await f.seek(Start { offset: 0u64 });
    var read_buf = Bytes.new();
    read_buf.push(0u8);
    read_buf.push(0u8);
    var read_count = await f.read(read_buf);
    var first_two = read_buf.slice(2, read_buf.size());
    var rest = Bytes.new();
    var rest_count = await f.read_to_end(rest);
    var seek_end = await f.seek(End { offset: 0 });
    var closed = await f.close();
    var after_close = await f.read_to_end(Bytes.new());
    await println("file_io=${write_count as i64} ${read_count as i64} ${first_two.to_str()} ${rest_count as i64} ${rest.to_str()} ${flushed is null} ${seek_start is i64} ${seek_end is i64} ${closed is null} ${after_close is IoError}");
  }
  await remove(file_io_path);

  var mutation_root = Path.new("/tmp/otter_fusion_std_fs_mutation_basic");
  var mutation_a = mutation_root.join("a");
  var mutation_nested = mutation_a.join("b");
  var mutation_file = mutation_nested.join("first.txt");
  var mutation_moved = mutation_nested.join("second.txt");
  await remove(mutation_moved);
  await remove(mutation_file);
  await remove(mutation_nested);
  await remove(mutation_a);
  await remove(mutation_root);

  var made_root = await create_dir(mutation_root);
  var made_nested = await create_dir_all(mutation_nested);
  var wrote_mutation = await write_string(mutation_file, "move-me");
  var renamed = await rename(mutation_file, mutation_moved);
  var old_exists = await mutation_file.exists();
  var moved_exists = await mutation_moved.exists();
  var canonical_method = await mutation_moved.canonicalize();
  var canonical_function = await canonicalize(mutation_nested.join("..").join("b").join("second.txt"));
  var canonical_missing = await canonicalize(mutation_nested.join("missing.txt"));
  var listing = await read_dir(mutation_nested);
  var missing_listing = await read_dir(mutation_nested.join("missing-dir"));
  var listing_count = 0;
  var saw_moved = false;
  if listing is DirEntries {
    for item in (listing as DirEntries) {
      if item is DirEntry {
        var entry = item as DirEntry;
        listing_count = listing_count + 1;
        if entry.path().ends_with(Path.new("second.txt")) && entry.kind().to_str() == "file" {
          saw_moved = true;
        }
      }
    }
  }
  var removed_file = await remove(mutation_moved);
  var removed_nested = await remove(mutation_nested);
  var removed_a = await remove(mutation_a);
  var removed_root = await remove(mutation_root);
  var root_exists_after = await mutation_root.exists();
  if made_root is null && made_nested is null && wrote_mutation is null && renamed is null &&
    old_exists is bool && moved_exists is bool && removed_file is null && removed_nested is null &&
    removed_a is null && removed_root is null && root_exists_after is bool {
    await println("mutate=${made_root is null} ${made_nested is null} ${wrote_mutation is null} ${renamed is null} ${!(old_exists as bool)} ${moved_exists as bool} ${removed_file is null} ${removed_root is null} ${!(root_exists_after as bool)}");
  }
  if canonical_method is Path && canonical_function is Path {
    await println("canon=${(canonical_method as Path).ends_with(Path.new("otter_fusion_std_fs_mutation_basic/a/b/second.txt"))} ${(canonical_function as Path).ends_with(Path.new("otter_fusion_std_fs_mutation_basic/a/b/second.txt"))} ${canonical_missing is IoError}");
  }
  await println("read_dir=${listing_count == 1} ${saw_moved} ${missing_listing is IoError}");

  var opened = await File.open(path);
  if opened is File {
    var file = opened as File;
    var text = await file.read_to_string();
    if text is str {
      await println("file=${text as str} path=${file.path().as_str()} append=${file.is_append_mode()}");
    }
  }

  var created = await File.create(path);
  if created is File {
    var file = created as File;
    var rewrote = await file.write_string("reset");
    if rewrote is null {
      var text = await file.read_to_string();
      if text is str {
        await println("overwrite=${text as str}");
      }
    }
  }

  var appender = await File.append(path);
  if appender is File {
    var file = appender as File;
    var wrote_tail = await file.write_string("+tail");
    if wrote_tail is null {
      var text = await file.read_to_string();
      var closed = await file.close();
      if text is str {
        await println("append_mode=${file.is_append_mode()} after=${text as str} close=${closed is null}");
      }
    }
  }

  var options_path = Path.new("/tmp/otter_fusion_std_fs_options_basic.txt");
  await remove(options_path);
  var options = open_options().with_read(true).with_write(true).with_create(true).with_truncate(true);
  var option_file = await File.open_with(options_path, options);
  if option_file is File {
    var file = option_file as File;
    var wrote_options = await file.write_string("opts");
    var closed_options = await file.close();
    var append_options = open_options().with_read(true).with_append(true).with_create(true);
    var appended_options = await File.open_with(options_path, append_options);
    if wrote_options is null && closed_options is null && appended_options is File {
      var app = appended_options as File;
      var wrote_more = await app.write_string("+more");
      var closed_app = await app.close();
      var text = await read_to_string(options_path);
      var duplicate = await File.open_with(options_path, open_options().with_write(true).with_create_new(true));
      if wrote_more is null && closed_app is null && text is str {
        await println("open_options=${options == options.clone()} ${options.hash() == options.clone().hash()} ${text as str} ${duplicate is IoError} ${app.is_append_mode()} ${options.to_str()}");
      }
    }
  }
  var invalid_empty = open_options();
  var invalid_create = open_options().with_read(true).with_create(true);
  var invalid_empty_error = invalid_empty.validation_error();
  var invalid_create_error = invalid_create.validate();
  var invalid_open = await File.open_with(options_path, invalid_empty);
  if invalid_empty_error is IoError && invalid_create_error is IoError {
    await println("open_options_validate=${options.is_valid()} ${options.validate() is null} ${!invalid_empty.is_valid()} ${(invalid_empty_error as IoError).message()} ${invalid_open is IoError} ${(invalid_create_error as IoError).message()}");
  }
  await remove(options_path);

  var missing = await read_to_string(missing_path);
  await println("missing=${missing is IoError}");
  null
}
