//@ kind: compile-error
//@ description: std:process Child.stderr is a non-Future current-stdio placeholder accessor; streamed child stderr remains planned async-stream work
//@ stderr: `await` requires a `Future`

import { Future } from "core:prelude";
import { Child, Command } from "std:process";

function main(): Future<null> async {
  var spawned = await Command.new("true").spawn();
  if spawned is Child {
    var _stderr = await (spawned as Child).stderr();
  }
  null
}
