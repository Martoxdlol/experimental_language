//@ kind: compile-error
//@ description: std:net AsyncUdpSocket.debug is ordinary diagnostic rendering, not an async datagram operation
//@ stderr: `await` requires a `Future`

import { Future } from "core:prelude";
import { Debug } from "std:fmt";
import { AsyncUdpSocket, UdpSocket } from "std:net";
import { ip_v4, socket_addr } from "std:net/types";

function main(): Future<null> async {
  var bound = await UdpSocket.bind(socket_addr(ip_v4(127u8, 0u8, 0u8, 1u8), 0u16));
  if bound is UdpSocket {
    var socket = AsyncUdpSocket.from_socket(bound as UdpSocket);
    var _debug = await socket.debug();
  }
  null
}
