//@ kind: run
//@ serial
//@ env: OTTER_FUSION_GC=stress
//@ description: AsyncTcpStream keeps managed state rooted across helper-backed TCP write/read awaits while stress GC runs
//@ stdout:
//~ async-tcp-stress=seed:otter 4 1 0

import { Future } from "core:prelude";
import { List } from "core:collections";
import { Bytes } from "std:bytes";
import { println, IoError, OtherIo } from "std:io";
import { AsyncTcpStream, TcpListener, TcpStream } from "std:net";
import { SocketAddr, ip_v4, socket_addr } from "std:net/types";
import { Thread, JoinHandle, Joined, Panicked } from "std:thread";

function trim_read_buffer(buf: Bytes, request_len: i64): Bytes {
  var i = 0;
  while i < request_len {
    var _ = buf.remove_at(0);
    i = i + 1;
  }
  buf
}

function decode_appended(buf: Bytes, request_len: i64): str {
  var decoded = trim_read_buffer(buf, request_len).decode_utf8();
  if decoded is str { decoded as str } else { "utf8-error" }
}

function filled_buffer(len: i64): Bytes {
  var buf = Bytes.new();
  var i = 0;
  while i < len {
    buf.push(0u8);
    i = i + 1;
  }
  buf
}

function read_text(stream: TcpStream, len: i64): Future<str> async {
  var buf = filled_buffer(len);
  var read = await stream.read(buf);
  if read is IoError || (read as i64) != len {
    "read-error"
  } else {
    decode_appended(buf, len)
  }
}

function serve(listener: TcpListener): Future<i64> async {
  var accepted = await listener.accept();
  if accepted is IoError {
    return -1;
  }

  var pair = accepted as (TcpStream, SocketAddr);
  var stream = pair.0;
  var request = await read_text(stream, 4);
  var wrote = await stream.write_all(Bytes.from_str("otter"));
  var flushed = await stream.flush();
  var stream_closed = await stream.close();
  var listener_closed = await listener.close();
  if request != "fish" {
    -2
  } else if wrote is IoError || flushed is IoError || stream_closed is IoError || listener_closed is IoError {
    -3
  } else {
    1
  }
}

function joined_value(result: Joined<i64> | Panicked): i64 {
  match result {
    Joined<i64> joined => joined.value,
    Panicked panic => -99,
  }
}

function exchange(stream: AsyncTcpStream, seed: str): Future<str | IoError> async {
  var roots: List<str> = [];
  roots.push(seed);
  var sent = await stream.write_async(Bytes.from_str("fish"));
  if sent is IoError {
    return sent as IoError;
  }

  roots.push("after-write");
  var buf = filled_buffer(5);
  var received = await stream.read_async(buf);
  if received is IoError {
    received as IoError
  } else if (sent as i64) != 4 || (received as i64) != 5 {
    __std_net_tcp_stress_error()
  } else {
    roots[0] + ":" + decode_appended(buf, 5)
  }
}

function __std_net_tcp_stress_error(): IoError {
  IoError { kind: OtherIo {}, message: "unexpected TCP stress byte count" }
}

function main(): Future<null> async {
  var bound = await TcpListener.bind(socket_addr(ip_v4(127u8, 0u8, 0u8, 1u8), 0u16));
  if bound is IoError {
    await println("async-tcp-stress=bind-error -1 -1 -1");
    return null;
  }

  var listener = bound as TcpListener;
  var local = await listener.local_addr();
  if local is IoError {
    await println("async-tcp-stress=addr-error -1 -1 -1");
    return null;
  }

  var worker: JoinHandle<i64> = Thread.spawn(() async => await serve(listener.clone()));
  var connected = await AsyncTcpStream.connect(local as SocketAddr);
  if connected is IoError {
    await println("async-tcp-stress=connect-error -1 -1 -1");
    return null;
  }

  var client = connected as AsyncTcpStream;
  var result = await exchange(client, "seed");
  var close_client = await client.close();
  var joined = await worker.join();
  await println("async-tcp-stress=${if result is str { result as str } else { "exchange-error" }} 4 ${joined_value(joined)} ${if close_client is IoError { 1 } else { 0 }}");
  null
}
