//@ kind: run
//@ description: std:io exposes stdin read methods as async target-backed handle futures
//@ stdin: abcdef
//@ stdout:
//~ stdin=2 bytes[97,98] 4 bytes[99,100,101,102] 0 bytes[]
import { Future } from "core:prelude";
import { Bytes } from "std:bytes";
import { println, stdin } from "std:io";

function main(): Future<null> async {
  var input = stdin();
  var first = Bytes.new();
  first.push(0u8);
  first.push(0u8);
  var first_count = await input.read(first);
  var first_payload = first.slice(2, first.size());

  var rest = Bytes.new();
  var rest_count = await input.read_to_end(rest);

  var eof = Bytes.new();
  var eof_count = await input.read_to_end(eof);

  await println("stdin=${first_count as i64} ${first_payload.to_str()} ${rest_count as i64} ${rest.to_str()} ${eof_count as i64} ${eof.to_str()}");
  null
}
