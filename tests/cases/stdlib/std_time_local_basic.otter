//@ kind: run
//@ description: std:time exposes provider-backed local timezone offset conversion helpers
//@ stdout:
//~ now=true true true true
//~ epoch=true true true
//~ fixed=true true true

import { Future } from "core:prelude";
import { DateTime, SystemTime, TimeError } from "std:time";
import { println } from "std:io";

function in_range(value: i64, low: i64, high: i64): bool {
  value >= low && value <= high
}

function status(value: DateTime | TimeError): str {
  if value is DateTime {
    "datetime"
  } else {
    "error"
  }
}

function main(): Future<null> async {
  var before_time = await SystemTime.now();
  var before = before_time.as_unix_nanos();
  var utc_now = await DateTime.now_utc();
  var local_now = await DateTime.now_local();
  var after_time = await SystemTime.now();
  var after = after_time.as_unix_nanos();

  var utc_roundtrip = utc_now.to_system_time() as SystemTime;
  var local_roundtrip = local_now.to_system_time() as SystemTime;
  await println("now=${utc_now.timezone().is_utc()} ${local_now.timezone().is_fixed_offset()} ${in_range(utc_roundtrip.as_unix_nanos(), before, after)} ${in_range(local_roundtrip.as_unix_nanos(), before, after)}");

  var epoch_local = await DateTime.from_system_time_local(SystemTime.unix_epoch());
  if epoch_local is DateTime {
    var dt = epoch_local as DateTime;
    var sys = dt.to_system_time() as SystemTime;
    var has_separator = dt.format_iso8601().contains("T");
    await println("epoch=${dt.timezone().is_fixed_offset()} ${sys.as_unix_nanos() == 0} ${has_separator}");
  } else {
    await println("epoch=false false false");
  }

  var fixed = await DateTime.from_system_time_local(SystemTime.from_unix_nanos(1234567890000000000));
  var is_datetime = status(fixed) == "datetime";
  await println("fixed=${is_datetime} ${(fixed as DateTime).timezone().is_fixed_offset()} ${((fixed as DateTime).to_system_time() as SystemTime).as_unix_nanos() == 1234567890000000000}");
  null
}
