//@ kind: run
//@ serial
//@ description: std:net TcpListener/TcpStream support a loopback round trip with Reader/Writer IO and socket addresses
//@ stdout:
//~ tcp=true true ping pong 1 0

import { Future } from "core:prelude";
import { Bytes } from "std:bytes";
import { println, IoError } from "std:io";
import { TcpStream, TcpListener } from "std:net";
import { SocketAddr, ip_v4, socket_addr } from "std:net/types";
import { Thread, JoinHandle, Joined, Panicked } from "std:thread";

function trim_read_buffer(buf: Bytes, request_len: i64): Bytes {
  var i = 0;
  while i < request_len {
    var _ = buf.remove_at(0);
    i = i + 1;
  }
  buf
}

function read_text(stream: TcpStream, len: i64): str {
  var buf = Bytes.new();
  var i = 0;
  while i < len {
    buf.push(0u8);
    i = i + 1;
  }
  var read = stream.read(buf);
  if read is IoError || (read as i64) != len {
    "read-error"
  } else {
    var decoded = trim_read_buffer(buf, len).decode_utf8();
    if decoded is str { decoded as str } else { "utf8-error" }
  }
}

function serve(listener: TcpListener): i64 {
  var accepted = listener.accept();
  if accepted is IoError {
    return -1;
  }

  var pair = accepted as (TcpStream, SocketAddr);
  var stream = pair.0;
  var request = read_text(stream, 4);
  if request != "ping" {
    return -2;
  }

  var nodelay = stream.set_nodelay(true);
  if nodelay is IoError {
    return -3;
  }

  var write = stream.write_all(Bytes.from_str("pong"));
  if write is IoError {
    return -4;
  }

  var flush = stream.flush();
  if flush is IoError {
    return -5;
  }

  var close_stream = stream.close();
  if close_stream is IoError {
    return -6;
  }

  var close_listener = listener.close();
  if close_listener is IoError {
    return -7;
  }

  if pair.1.ip().to_str() == "127.0.0.1" { 1 } else { -8 }
}

function joined_value(result: Joined<i64> | Panicked): i64 {
  match result {
    Joined<i64> joined => joined.value,
    Panicked panic => -99,
  }
}

function main(): Future<null> async {
  var bound = TcpListener.bind(socket_addr(ip_v4(127u8, 0u8, 0u8, 1u8), 0u16));
  if bound is IoError {
    println("tcp=false false bind-error bind-error -1 -1");
    return null;
  }

  var listener = bound as TcpListener;
  var local = listener.local_addr();
  if local is IoError {
    println("tcp=false false local-error local-error -1 -1");
    return null;
  }

  var addr = local as SocketAddr;
  var worker: JoinHandle<i64> = Thread.spawn(() => serve(listener.clone()));
  var connected = TcpStream.connect(addr);
  if connected is IoError {
    println("tcp=false false connect-error connect-error -1 -1");
    return null;
  }

  var client = connected as TcpStream;
  var peer = client.peer_addr();
  var peer_matches = peer is SocketAddr && (peer as SocketAddr).port() == addr.port();
  var nodelay = client.set_nodelay(true);
  var write = client.write_all(Bytes.from_str("ping"));
  var request_ok = !(write is IoError) && !(nodelay is IoError);
  var response = if request_ok { read_text(client, 4) } else { "write-error" };
  var close_client = client.close();
  var joined = await worker.join();
  println("tcp=${request_ok} ${peer_matches} ping ${response} ${joined_value(joined)} ${if close_client is IoError { 1 } else { 0 }}");
  null
}
