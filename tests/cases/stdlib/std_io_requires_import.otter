import { Bytes } from "std:bytes";

function use_reader(reader: Reader): i64 | IoError {
  reader.read(Bytes.new())
}

function use_writer(writer: Writer): null | IoError {
  writer.flush()
}

function use_seeker(seeker: Seeker, pos: SeekFrom): i64 | IoError {
  seeker.seek(pos)
}

