//@ kind: run
//@ description: std:process supports live Child handles with spawn, id, wait, cached wait, clone sharing, kill, and validation/provider errors
//@ stdout:
//~ spawn=true true true true
//~ wait=true true true
//~ clone-wait=true true
//~ missing=true invalid=true
//~ kill=true true true

import { Command, Child, ExitStatus } from "std:process";
import { IoError } from "std:io";
import { println } from "std:io";

function status_success(value: ExitStatus | IoError): bool {
  if value is ExitStatus {
    (value as ExitStatus).success()
  } else {
    false
  }
}

function status_not_success(value: ExitStatus | IoError): bool {
  if value is ExitStatus {
    !(value as ExitStatus).success()
  } else {
    false
  }
}

function main() {
  var spawned = Command.new("true").spawn();
  if spawned is IoError {
    println("spawn=false false false false");
    println("wait=false false false");
    println("clone-wait=false false");
  } else {
    var child = spawned as Child;
    println("spawn=${child.id() > 0u32} ${child.stdin() is null} ${child.stdout() is null} ${child.stderr() is null}");

    var waited = child.wait();
    var waited_again = child.wait();
    println("wait=${status_success(waited)} ${status_success(waited_again)} ${(waited as ExitStatus) == (waited_again as ExitStatus)}");

    var clone = child.clone();
    var clone_waited = clone.wait();
    println("clone-wait=${status_success(clone_waited)} ${(clone_waited as ExitStatus) == (waited as ExitStatus)}");
  }

  var missing = Command.new("__otter_fusion_missing_process_child_for_stdlib_test__").spawn();
  var invalid = Command.new("").spawn();
  println("missing=${missing is IoError} invalid=${invalid is IoError}");

  var sleeper = Command.new("sleep").arg("5").spawn();
  if sleeper is IoError {
    println("kill=false false false");
  } else {
    var child = sleeper as Child;
    var killed = child.kill();
    var status = child.wait();
    println("kill=${killed is null} ${status is ExitStatus} ${status_not_success(status)}");
  }
}
