//@ kind: run
//@ description: async std:process supports live Child handles with spawn, id, wait, cached wait, clone sharing, kill, and validation/provider errors
//@ stdout:
//~ spawn=true true true true
//~ wait=true true true
//~ clone-wait=true true
//~ missing=true invalid=true
//~ kill=true true true

import { Future } from "core:prelude";
import { Command, Child, ExitStatus } from "std:process";
import { IoError } from "std:io";
import { println } from "std:io";

function status_success(value: ExitStatus | IoError): bool {
  if value is ExitStatus {
    (value as ExitStatus).success()
  } else {
    false
  }
}

function status_not_success(value: ExitStatus | IoError): bool {
  if value is ExitStatus {
    !(value as ExitStatus).success()
  } else {
    false
  }
}

function main(): Future<null> async {
  var spawned = await Command.new("true").spawn();
  if spawned is IoError {
    await println("spawn=false false false false");
    await println("wait=false false false");
    await println("clone-wait=false false");
  } else {
    var child = spawned as Child;
    await println("spawn=${child.id() > 0u32} ${child.stdin() is null} ${child.stdout() is null} ${child.stderr() is null}");

    var waited = await child.wait();
    var waited_again = await child.wait();
    await println("wait=${status_success(waited)} ${status_success(waited_again)} ${(waited as ExitStatus) == (waited_again as ExitStatus)}");

    var clone = child.clone();
    var clone_waited = await clone.wait();
    await println("clone-wait=${status_success(clone_waited)} ${(clone_waited as ExitStatus) == (waited as ExitStatus)}");
  }

  var missing = await Command.new("__otter_fusion_missing_process_child_for_stdlib_test__").spawn();
  var invalid = await Command.new("").spawn();
  await println("missing=${missing is IoError} invalid=${invalid is IoError}");

  var sleeper = await Command.new("sleep").arg("5").spawn();
  if sleeper is IoError {
    await println("kill=false false false");
  } else {
    var child = sleeper as Child;
    var killed = await child.kill();
    var status = await child.wait();
    await println("kill=${killed is null} ${status is ExitStatus} ${status_not_success(status)}");
  }
  null
}
