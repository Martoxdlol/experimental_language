//@ kind: compile-error
//@ description: target-backed std:io stderr exposes Future-returning writes and cannot satisfy the ordinary in-memory Writer contract
//@ stderr: type `Stderr` does not implement `Writer`

import { Future } from "core:prelude";
import { Bytes } from "std:bytes";
import { IoError, Writer, stderr } from "std:io";

function write_in_memory<T: Writer>(writer: T): null | IoError {
  writer.write_all(Bytes.from_str("x"))
}

function main(): Future<null> async {
  var _ = write_in_memory(stderr());
  null
}
