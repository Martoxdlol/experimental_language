//@ kind: compile-error
//@ description: target-backed std:io stdin exposes Future-returning reads and cannot satisfy the ordinary in-memory Reader contract
//@ stderr: type `Stdin` does not implement `Reader`

import { Future } from "core:prelude";
import { Bytes } from "std:bytes";
import { IoError, Reader, stdin } from "std:io";

function read_in_memory<T: Reader>(reader: T): i64 | IoError {
  reader.read(Bytes.new())
}

function main(): Future<null> async {
  var _ = read_in_memory(stdin());
  null
}
