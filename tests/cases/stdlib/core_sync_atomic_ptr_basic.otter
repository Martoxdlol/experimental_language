//@ kind: run
//@ description: AtomicPtr<T> preserves typed raw pointer operations through the runtime atomic handle
//@ stdout:
//~ ptr-values=10/10/30/10/10/10
//~ ptr-addrs=true true true true true true
//~ ptr-clone=20/20 true
import { Future } from "core:prelude";
import { AtomicPtr, SeqCst } from "core:sync/atomic";
import { println } from "std:io";

extern struct Cell { value: i64 }

function main(): Future<null> async {
  var a = Cell { value: 10 };
  var b = Cell { value: 20 };
  var c = Cell { value: 30 };
  var pa = (&a) as *Cell;
  var pb = (&b) as *Cell;
  var pc = (&c) as *Cell;

  var atomic = AtomicPtr.new<Cell>(pa);
  var first = atomic.load(SeqCst {});
  var swapped = atomic.swap(pb, SeqCst {});
  atomic.store(pc, SeqCst {});
  var cas_success = atomic.compare_exchange(pc, pa, SeqCst {}, SeqCst {});
  var after_success = atomic.load(SeqCst {});
  var cas_failure = atomic.compare_exchange(pc, pb, SeqCst {}, SeqCst {});
  var after_failure = atomic.load(SeqCst {});

  var values_line = "ptr-values=${(*first).value}/${(*swapped).value}/${(*cas_success).value}/${(*after_success).value}/${(*cas_failure).value}/${(*after_failure).value}";
  var addrs_line = "ptr-addrs=${(first as usize) == (pa as usize)} ${(swapped as usize) == (pa as usize)} ${(cas_success as usize) == (pc as usize)} ${(after_success as usize) == (pa as usize)} ${(cas_failure as usize) == (pa as usize)} ${(after_failure as usize) == (pa as usize)}";

  var copy = atomic.clone();
  copy.store(pb, SeqCst {});
  var original_load = atomic.load(SeqCst {});
  var copy_load = copy.load(SeqCst {});
  var clone_line = "ptr-clone=${(*original_load).value}/${(*copy_load).value} ${(original_load as usize) == (copy_load as usize)}";

  await println(values_line);
  await println(addrs_line);
  await println(clone_line);
  null
}
