//@ kind: run
//@ description: std:io async concrete handles park on reactor-backed futures instead of blocking executor polls
//@ stdin: abcdef
//@ stdout:
//~ async-write
//~ async-stdin=2 bytes[97,98] 4 bytes[99,100,101,102] true
import { Bytes } from "std:bytes";
import { Future } from "core:prelude";
import { println, stdin, stdout } from "std:io";

function main(): Future<null> async {
  var input = stdin();
  var first = Bytes.new();
  first.push(0u8);
  first.push(0u8);
  var first_count = await input.read_async(first);
  var first_payload = first.slice(2, first.size());

  var rest = Bytes.new();
  var rest_count = await input.read_to_end_async(rest);

  var out = stdout();
  var wrote = await out.write_all_async(Bytes.from_str("async-write\n"));
  var flushed = await out.flush_async();

  println("async-stdin=${first_count as i64} ${first_payload.to_str()} ${rest_count as i64} ${rest.to_str()} ${wrote is null && flushed is null}");
}
