//@ kind: run
//@ description: anonymous tuple construction and indexing
//@ stdout:
//~ 1
//~ hi
//~ true
import { Future } from "core:prelude";
import { println } from "std:io";
function main(): Future<null> async {
  var t = (1, "hi", true);
  await println("${t.0}");
  await println(t.1);
  await println("${t.2}");
  null
}
