//@ kind: run
//@ description: integer add/sub/mul/div/rem and left-associativity
//@ stdout:
//~ 5
//~ 5
//~ 3
//~ 2
//~ -8
import { Future } from "core:prelude";
import { println } from "std:io";
function main(): Future<null> async {
  await println("${10 - 3 - 2}");
  await println("${7 / 2 + 2}");
  await println("${15 / 5}");
  await println("${17 % 5}");
  await println("${0 - 8}");
  null
}
