//@ kind: run
//@ description: operator precedence and grouping
//@ stdout:
//~ 7
//~ 9
//~ 1
//~ 14
import { Future } from "core:prelude";
import { println } from "std:io";
function main(): Future<null> async {
  await println("${1 + 2 * 3}");
  await println("${(1 + 2) * 3}");
  await println("${7 % 3}");
  await println("${2 * 3 + 4 * 2}");
  null
}
