//@ kind: run
//@ description: floating-point arithmetic
//@ stdout:
//~ 6.5
//~ 2
//~ 7.5
import { Future } from "core:prelude";
import { println } from "std:io";
function main(): Future<null> async {
  await println("${2.0 + 4.5}");
  await println("${5.0 / 2.5}");
  await println("${1.5 * 5.0}");
  null
}
