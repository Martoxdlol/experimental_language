//@ kind: run
//@ description: the block ANF introduces for a nested-`await` short-circuit operand can sit under another operator (`!`); the suspend site is still discovered and every live local saved across it (docs/21)
//@ stdout:
//~ false
import { Future } from "core:prelude";
import { println } from "std:io";
import { yield_now } from "std:async";
function n(v: i64): Future<i64> async {
  await yield_now();
  v
}
function main(): Future<null> async {
  var z = !(true && ((await n(5)) > 0));
  await println("${z}");
  null
}
