//@ kind: run
//@ description: an `await` in the right operand of `&&` is a conditional suspend point — the future (and its side effect) runs only when the left operand is true, never when it short-circuits (docs/21 §4)
//@ stdout:
//~ B
//~ a=false b=true
import { Future } from "core:prelude";
import { println, print } from "std:io";
import { yield_now } from "std:async";
function side(tag: str, b: bool): Future<bool> async {
  await yield_now();
  await print(tag);
  b
}
function main(): Future<null> async {
  var a = false && await side("A", true);
  var b = true && await side("B", true);
  await println("");
  await println("a=${a} b=${b}");
  null
}
