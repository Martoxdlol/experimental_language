//@ kind: run
//@ description: a `while` condition mixing short-circuit `&&` with a nested `await`, plus a body that also awaits — the condition await only runs when the left side is true, and suspends once per iteration (docs/21 §4)
//@ stdout:
//~ cbcbcb
//~ sum=3 i=3
import { Future } from "core:prelude";
import { println, print } from "std:io";
import { yield_now } from "std:async";
function probe(tag: str, i: i64): Future<i64> async {
  await yield_now();
  await print(tag);
  i
}
function main(): Future<null> async {
  var i = 0;
  var sum = 0;
  while (i < 3) && ((await probe("c", i)) >= 0) {
    sum = sum + (await probe("b", i));
    i = i + 1;
  }
  await println("");
  await println("sum=${sum} i=${i}");
  null
}
