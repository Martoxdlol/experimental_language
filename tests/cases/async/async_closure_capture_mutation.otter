//@ kind: run
//@ description: an async closure captures by reference (docs/09 §7) — a mutation inside the body across an `await` is visible to the next poll and to the enclosing scope (docs/21 §7)
//@ stdout:
//~ a=1 b=2 counter=2
import { Future } from "core:prelude";
import { println } from "std:io";
import { sleep } from "std:async";
function main(): Future<null> async {
  var counter: i64 = 0;
  var bump = function(): Future<i64> async {
    var _ = await sleep(1);
    counter = counter + 1;
    counter
  };
  var a: i64 = await bump();
  var b: i64 = await bump();
  await println("a=${a} b=${b} counter=${counter}");
  null
}
