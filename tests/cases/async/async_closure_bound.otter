//@ kind: run
//@ description: an async closure `function(p): Future<T> async { … }` bound to a local, capturing an outer var and suspending on `await sleep`, then driven with `await` (docs/21 §7)
//@ stdout:
//~ v=105
import { println } from "std:io";
import { Future } from "core:prelude";
import { sleep } from "std:async";
function main(): Future < null > async {
  var base: i64 = 100;
  var f = function(x: i64): Future < i64 > async {
    var _ = await sleep(1);
    base + x
  };
  var v: i64 = await f(5);
  println("v=${v }");
}
