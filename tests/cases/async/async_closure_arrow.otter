//@ kind: run
//@ description: an async arrow closure `(p) async => E` capturing the outer environment, driven with `await` (docs/21 §7)
//@ stdout:
//~ g=40
import { println } from "std:io";
import { Future } from "core:prelude";
function main(): Future<null> async {
  var base: i64 = 10;
  var g = (n: i64): Future<i64> async => base * n;
  println("g=${await g(4) }");
}
