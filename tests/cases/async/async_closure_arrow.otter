//@ kind: run
//@ description: an async arrow closure `(p) async => E` capturing the outer environment, awaited until it resolves (docs/21 §7)
//@ stdout:
//~ g=40
import { Future } from "core:prelude";
import { println } from "std:io";
function main(): Future<null> async {
  var base: i64 = 10;
  var g = (n: i64): Future<i64> async => base * n;
  await println("g=${await g(4)}");
  null
}
