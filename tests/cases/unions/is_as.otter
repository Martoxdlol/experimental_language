//@ kind: run
//@ description: union is/as narrowing
//@ stdout:
//~ is int
//~ 42
//~ is str
import { Future } from "core:prelude";
import { println } from "std:io";
function describe(x: i64 | str): str {
  if x is i64 { "is int" } else { "is str" }
}
function main(): Future<null> async {
  var a: i64 | str = 42;
  await println(describe(a));
  if a is i64 { await println("${a as i64}"); }
  var b: i64 | str = "hello";
  await println(describe(b));
  null
}
