//@ kind: run
//@ description: T | null option-like values
//@ stdout:
//~ has value
//~ 7
//~ empty
import { Future } from "core:prelude";
import { println } from "std:io";
function main(): Future<null> async {
  var x: i64 | null = 7;
  if x is i64 {
    await println("has value");
    await println("${x as i64}");
  }
  var y: i64 | null = null;
  if y is null { await println("empty"); }
  null
}
