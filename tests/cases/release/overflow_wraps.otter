//@ kind: run
//@ release
//@ description: under --release, integer overflow wraps (two's complement)
//@ stdout:
//~ -9223372036854775808
import { Future } from "core:prelude";
import { println } from "std:io";
function main(): Future<null> async {
  var x = 9223372036854775807;
  await println("${x + 1}");
  null
}
