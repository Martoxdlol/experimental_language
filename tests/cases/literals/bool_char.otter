//@ kind: run
//@ description: boolean and character literals
//@ stdout:
//~ true
//~ false
//~ A
//~ z
import { Future } from "core:prelude";
import { println } from "std:io";
function main(): Future<null> async {
  await println("${true}");
  await println("${false}");
  await println("${'A'}");
  await println("${'z'}");
  null
}
