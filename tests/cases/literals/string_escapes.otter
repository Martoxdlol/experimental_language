//@ kind: run
//@ description: string escape sequences
//@ stdout:
//~ tab	here
//~ quote " done
//~ back \ slash
import { Future } from "core:prelude";
import { println } from "std:io";
function main(): Future<null> async {
  await println("tab\there");
  await println("quote \" done");
  await println("back \\ slash");
  null
}
