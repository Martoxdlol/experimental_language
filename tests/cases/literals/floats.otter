//@ kind: run
//@ description: floating-point literals and formatting
//@ stdout:
//~ 3.14
//~ 0.5
//~ 100
//~ -2.5
import { Future } from "core:prelude";
import { println } from "std:io";
function main(): Future<null> async {
  await println("${3.14}");
  await println("${0.5}");
  await println("${1e2}");
  await println("${-2.5}");
  null
}
