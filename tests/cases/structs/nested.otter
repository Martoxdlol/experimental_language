//@ kind: run
//@ description: nested struct field access
//@ stdout:
//~ 5
import { Future } from "core:prelude";
import { println } from "std:io";
struct Inner { v: i64 }
struct Outer { inner: Inner }
function main(): Future<null> async {
  var o = Outer { inner: Inner { v: 5 } };
  await println("${o.inner.v}");
  null
}
