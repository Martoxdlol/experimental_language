//@ kind: run
//@ description: field-init shorthand and ..spread update
//@ stdout:
//~ 1
//~ 2
//~ 99
//~ 2
import { println } from "std:io";
struct P { x: i64, y: i64 }
function main() {
  var x = 1;
  var y = 2;
  var a = P { x, y };
  println("${a.x}");
  println("${a.y}");
  var b = P { x: 99, ..a };
  println("${b.x}");
  println("${b.y}");
}
