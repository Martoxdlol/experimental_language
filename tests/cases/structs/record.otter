//@ kind: run
//@ description: record struct construction, field access and mutation
//@ stdout:
//~ 3
//~ 4
//~ 30
import { Future } from "core:prelude";
import { println } from "std:io";
function main(): Future<null> async {
  var p = Point { x: 3, y: 4 };
  await println("${p.x}");
  await println("${p.y}");
  p.x = 30;
  await println("${p.x}");
  null
}
struct Point { x: i64, y: i64 }
