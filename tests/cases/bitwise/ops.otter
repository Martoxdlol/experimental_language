//@ kind: run
//@ description: bitwise and/or/xor/not and shifts
//@ stdout:
//~ 8
//~ 14
//~ 6
//~ 40
//~ 2
import { Future } from "core:prelude";
import { println } from "std:io";
function main(): Future<null> async {
  await println("${12 & 9}");
  await println("${12 | 2}");
  await println("${5 ^ 3}");
  await println("${5 << 3}");
  await println("${20 >> 3}");
  null
}
