//@ kind: run
//@ description: chained boolean operators with precedence
//@ stdout:
//~ true
//~ true
//~ true
import { Future } from "core:prelude";
import { println } from "std:io";
function main(): Future<null> async {
  await println("${true && false || true}");
  await println("${false || false || true}");
  await println("${!(1 > 2) && (3 >= 3)}");
  null
}
