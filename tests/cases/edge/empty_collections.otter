//@ kind: run
//@ description: empty list/map size and is_empty, then growth
//@ stdout:
//~ 0 true
//~ 1 false
//~ true
import { Future } from "core:prelude";
import { List, Map } from "core:collections";
import { println } from "std:io";
function main(): Future<null> async {
  var xs: List<i64> = [];
  await println("${xs.size()} ${xs.is_empty()}");
  xs.push(1);
  await println("${xs.size()} ${xs.is_empty()}");
  var m: Map<str, i64> = Map<str, i64>();
  await println("${m.is_empty()}");
  null
}
