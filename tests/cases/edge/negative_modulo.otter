//@ kind: run
//@ description: division and remainder with negative operands
//@ stdout:
//~ -3
//~ -1
//~ -3
//~ 1
import { Future } from "core:prelude";
import { println } from "std:io";
function main(): Future<null> async {
  await println("${-7 / 2}");
  await println("${-7 % 2}");
  await println("${7 / -2}");
  await println("${7 % -2}");
  null
}
