//@ kind: run
//@ description: a generic struct nested inside another generic struct
//@ stdout:
//~ 7
import { Future } from "core:prelude";
import { println } from "std:io";
struct Box<T> { v: T }
function main(): Future<null> async {
  var b: Box<Box<i64>> = Box<Box<i64>> { v: Box<i64> { v: 7 } };
  await println("${b.v.v}");
  null
}
