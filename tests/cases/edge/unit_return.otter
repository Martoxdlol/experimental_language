//@ kind: run
//@ description: a function with no declared return type yields unit
//@ stdout:
//~ hi ada
//~ hi bob
import { Future } from "core:prelude";
import { println } from "std:io";
function greet(name: str): Future<null> async {
  await println("hi " + name);
  null
}
function main(): Future<null> async {
  await greet("ada");
  await greet("bob");
  null
}
