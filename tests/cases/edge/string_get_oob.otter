//@ kind: run
//@ description: str.get past the end returns null (no panic)
//@ stdout:
//~ out of range
//~ a
import { Future } from "core:prelude";
import { println } from "std:io";
function main(): Future<null> async {
  var c = "abc".get(10);
  if c is null { await println("out of range"); }
  var d = "abc".get(0);
  if d is char { await println("${d as char}"); }
  null
}
