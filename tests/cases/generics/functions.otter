//@ kind: run
//@ description: generic functions with inference
//@ stdout:
//~ 42
//~ hi
//~ 99
import { println } from "std:io";
function id<T>(x: T): T { x }
function pick<T>(a: T, b: T, first: bool): T { if first { a } else { b } }
function main() {
  println("${id(42)}");
  println(id("hi"));
  println("${pick(1, 99, false)}");
}
