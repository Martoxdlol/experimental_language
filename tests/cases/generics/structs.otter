//@ kind: run
//@ description: generic struct with two type parameters
//@ stdout:
//~ 7
//~ seven
import { Future } from "core:prelude";
import { println } from "std:io";
struct Pair<A, B> { first: A, second: B }
function main(): Future<null> async {
  var p = Pair<i64, str> { first: 7, second: "seven" };
  await println("${p.first}");
  await println(p.second);
  null
}
