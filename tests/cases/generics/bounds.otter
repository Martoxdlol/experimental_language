//@ kind: run
//@ description: generic bound calls an interface method monomorphically
//@ stdout:
//~ 6
import { println } from "std:io";
import { Iterator, Item, Done } from "core:prelude";
struct Range { cur: i64, end: i64 }
extend Range: Iterator<i64> {
  function next(self): Item<i64> | Done {
    if self.cur >= self.end { Done {} }
    else { var v = self.cur; self.cur = self.cur + 1; Item { value: v } }
  }
}
function sum_all<T: Iterator<i64>>(it: T): i64 {
  var total = 0;
  for x in it { total = total + x; }
  total
}
function main() {
  println("${sum_all(Range { cur: 1, end: 4 })}");
}
