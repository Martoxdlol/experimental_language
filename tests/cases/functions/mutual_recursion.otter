//@ kind: run
//@ description: mutually recursive is_even/is_odd
//@ stdout:
//~ true
//~ true
//~ false
import { Future } from "core:prelude";
import { println } from "std:io";
function is_even(n: i64): bool {
  if n == 0 { true } else { is_odd(n - 1) }
}
function is_odd(n: i64): bool {
  if n == 0 { false } else { is_even(n - 1) }
}
function main(): Future<null> async {
  await println("${is_even(10)}");
  await println("${is_odd(7)}");
  await println("${is_even(3)}");
  null
}
