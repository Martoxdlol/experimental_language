//@ kind: run
//@ description: early return from a function
//@ stdout:
//~ found
//~ none
import { Future } from "core:prelude";
import { println } from "std:io";
function check(n: i64): str {
  if n > 0 { return "found"; }
  "none"
}
function main(): Future<null> async {
  await println(check(5));
  await println(check(-1));
  null
}
