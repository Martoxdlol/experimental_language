//@ kind: run
//@ description: while loop accumulation
//@ stdout:
//~ 55
import { Future } from "core:prelude";
import { println } from "std:io";
function main(): Future<null> async {
  var i = 1;
  var sum = 0;
  while i <= 10 {
    sum = sum + i;
    i = i + 1;
  }
  await println("${sum}");
  null
}
