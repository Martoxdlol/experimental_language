//@ kind: run
//@ description: if/else statements and chained else-if
//@ stdout:
//~ positive
//~ zero
//~ negative
import { Future } from "core:prelude";
import { println } from "std:io";
function classify(n: i64): str {
  if n > 0 { "positive" } else if n == 0 { "zero" } else { "negative" }
}
function main(): Future<null> async {
  await println(classify(5));
  await println(classify(0));
  await println(classify(-3));
  null
}
