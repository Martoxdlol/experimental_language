//@ kind: run
//@ description: nested loops with inner break
//@ stdout:
//~ 9
import { Future } from "core:prelude";
import { println } from "std:io";
function main(): Future<null> async {
  var count = 0;
  var i = 0;
  while i < 3 {
    var j = 0;
    while j < 5 {
      if j == 3 { break; }
      count = count + 1;
      j = j + 1;
    }
    i = i + 1;
  }
  await println("${count}");
  null
}
