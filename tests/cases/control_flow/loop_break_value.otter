//@ kind: run
//@ description: infinite loop with break carrying a value
//@ stdout:
//~ 16
import { Future } from "core:prelude";
import { println } from "std:io";
function main(): Future<null> async {
  var n = 1;
  var result = loop {
    if n > 10 { break n; }
    n = n * 2;
  };
  await println("${result}");
  null
}
