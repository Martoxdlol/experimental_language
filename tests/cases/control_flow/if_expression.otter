//@ kind: run
//@ description: if used as an expression yielding a value
//@ stdout:
//~ 100
//~ 1
import { Future } from "core:prelude";
import { println } from "std:io";
function main(): Future<null> async {
  var max = if 3 > 2 { 100 } else { 200 };
  await println("${max}");
  var min = if 3 < 2 { 100 } else { 1 };
  await println("${min}");
  null
}
