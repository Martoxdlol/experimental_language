//@ kind: run
//@ description: Map set/get/contains/remove/size and indexing
//@ stdout:
//~ 3
//~ 3
//~ true
//~ 2
//~ 42
import { Future } from "core:prelude";
import { Map } from "core:collections";
import { println } from "std:io";
function main(): Future<null> async {
  var m: Map<str, i64> = { "a": 1, "b": 2 };
  m.set("c", 3);
  await println("${m.size()}");
  match m.get("c") { i64 n => await println("${n}"), null => await println("none") };
  await println("${m.contains("a")}");
  m.remove("a");
  await println("${m.size()}");
  m["d"] = 42;
  await println("${m["d"]}");
  null
}
