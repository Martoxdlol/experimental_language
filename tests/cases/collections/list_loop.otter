//@ kind: run
//@ description: for loop over a list and each with implicit it
//@ stdout:
//~ 6
//~ 6
import { Future } from "core:prelude";
import { println } from "std:io";
function main(): Future<null> async {
  var xs = [1, 2, 3];
  var sum = 0;
  for x in xs { sum = sum + x; }
  await println("${sum}");
  var total = 0;
  xs.each { total = total + it; };
  await println("${total}");
  null
}
