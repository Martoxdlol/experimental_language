//@ kind: run
//@ description: List push/size/index/set/contains/index_of/truncate
//@ stdout:
//~ 4
//~ 10
//~ 99
//~ true
//~ 2
//~ 2
import { Future } from "core:prelude";
import { println } from "std:io";
function main(): Future<null> async {
  var xs = [10, 20, 30];
  xs.push(40);
  await println("${xs.size()}");
  await println("${xs[0]}");
  xs.set(0, 99);
  await println("${xs[0]}");
  await println("${xs.contains(30)}");
  var at = xs.index_of(30);
  if at is i64 { await println("${at as i64}"); }
  xs.truncate(2);
  await println("${xs.size()}");
  null
}
