//@ kind: run
//@ description: closures capture environment by reference
//@ stdout:
//~ 42
//~ 84
import { Future } from "core:prelude";
import { println } from "std:io";
function main(): Future<null> async {
  var inc = (n: i64): i64 => n + 1;
  await println("${inc(41)}");
  var factor = 2;
  var scale = (n: i64): i64 => n * factor;
  await println("${scale(42)}");
  null
}
