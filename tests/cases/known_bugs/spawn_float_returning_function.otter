//@ kind: run
//@ serial
//@ known-bug: spawning a function that returns a floating-point value is rejected ("Thread.spawn cannot yet return a floating-point value" / spawn requires a Future); concurrency should support float results
//@ description: spawn a float-returning function and join it
//@ stdout:
//~ 1.5
import { println } from "std:io";
import { JoinHandle, Joined, Panicked } from "std:thread";
function work(): f64 { 1.5 }
function main() {
  var h = spawn work();
  var r = h.join();
  match r {
    Joined<f64> j => println("${j.value}"),
    Panicked p => println("panicked"),
  };
}
