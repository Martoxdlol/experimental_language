//@ kind: compile-error
//@ serial
//@ known-bug: capturing a mutable loop variable by reference into `Thread.spawn` is silently accepted, but it then DATA-RACES across threads — producing wrong results (e.g. 59 instead of 45) or crashing with a signal. Per docs/20 §6 (no implicit sharing; spawn captures must be immutable) this should be a compile error.
//@ description: Thread.spawn closure captures a mutable loop variable (unsound)
//@ stderr: capture
import { List } from "core:collections";
import { println } from "std:io";
import { Future } from "core:prelude";
import { Thread, JoinHandle, Joined, Panicked } from "std:thread";
function ident(n: i64): i64 { n }
function gather(handles: List<JoinHandle<i64>>): Future<i64> async {
  var total = 0;
  for h in handles {
    var r: Joined<i64> | Panicked = await h.join();
    total = total + (match r { Joined<i64> j => j.value, Panicked p => 0 });
  }
  total
}
function main(): Future<null> async {
  var handles: List<JoinHandle<i64>> = [];
  var i = 0;
  // BUG: `() => ident(i)` captures the mutable `i` by reference.
  while i < 10 { handles.push(Thread.spawn(() => ident(i))); i = i + 1; }
  var total: i64 = await gather(handles);
  println("${total}");
}
