//@ kind: compile-error
//@ known-bug: a struct literal that sets the same field twice (`P { x: 1, x: 2 }`) is silently accepted (the last wins); it should be a duplicate-field compile error
//@ description: duplicate field in a struct literal
//@ stderr: field
import { println } from "std:io";
struct P { x: i64 }
function main() {
  var p = P { x: 1, x: 2 };
  println("${p.x}");
}
