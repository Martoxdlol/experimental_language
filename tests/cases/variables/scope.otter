//@ kind: run
//@ description: block scope shadows then restores outer binding
//@ stdout:
//~ 10
//~ 20
//~ 10
import { Future } from "core:prelude";
import { println } from "std:io";
function main(): Future<null> async {
  var x = 10;
  await println("${x}");
  if true {
    var x = 20;
    await println("${x}");
  }
  await println("${x}");
  null
}
