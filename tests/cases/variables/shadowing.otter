//@ kind: run
//@ description: variable shadowing and reassignment
//@ stdout:
//~ 1
//~ 2
//~ hello
import { Future } from "core:prelude";
import { println } from "std:io";
function main(): Future<null> async {
  var x = 1;
  await println("${x}");
  x = 2;
  await println("${x}");
  var x = "hello";
  await println(x);
  null
}
