//@ kind: panic
//@ description: panic(msg) aborts with the message after prior output
//@ stderr: boom
//@ stdout:
//~ before
import { Future } from "core:prelude";
import { println } from "std:io";
import { panic } from "core:prelude";
function main(): Future<null> async {
  await println("before");
  panic("boom");
  null
}
