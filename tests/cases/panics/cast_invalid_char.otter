//@ kind: panic
//@ description: casting an out-of-range integer to char panics
//@ stderr: cast to char is out of the Unicode range
import { Future } from "core:prelude";
import { println } from "std:io";
function main(): Future<null> async {
  var n = 2000000;
  var c = n as char;
  await println("${c}");
  null
}
