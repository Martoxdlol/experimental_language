//@ kind: run
//@ description: @Derive(Ord) gives lexicographic comparisons
//@ stdout:
//~ true
//~ false
//~ true
import { println } from "std:io";
import { Ord } from "core:prelude";
@Derive(Ord)
struct V { a: i64, b: i64 }
function main() {
  var p = V { a: 1, b: 2 };
  var q = V { a: 1, b: 5 };
  println("${p < q}");
  println("${p > q}");
  println("${p <= q}");
}
