//@ kind: run
//@ description: @Derive(ToStr) renders a struct and works in interpolation
//@ stdout:
//~ Point { x: 3, y: 4 }
//~ p = Point { x: 3, y: 4 }
import { println } from "std:io";
import { ToStr } from "core:prelude";
@Derive(ToStr)
struct Point { x: i64, y: i64 }
function main() {
  var p = Point { x: 3, y: 4 };
  println(p.to_str());
  println("p = ${p}");
}
