//@ kind: run
//@ env: LANG_GC=stress
//@ description: closures capturing heap values, churned under GC stress
//@ stdout:
//~ 4950
import { List } from "core:collections";
import { println } from "std:io";
function main() {
  var nums: List<i64> = [];
  var i = 0;
  while i < 100 { nums.push(i); i = i + 1; }
  var total = 0;
  var k = 0;
  while k < 20 {
    var sum = nums.fold(0, (acc: i64, x: i64): i64 => acc + x);
    total = sum;
    k = k + 1;
  }
  println("${total}");
}
