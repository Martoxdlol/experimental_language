//@ kind: run
//@ serial
//@ description: a Thread.spawn producer sends over a channel; an async consumer awaits recv()
//@ stdout:
//~ sum=30
import { println } from "std:io";
import { Future } from "core:prelude";
import { Thread, JoinHandle, Joined, Panicked } from "std:thread";
import { Sender, Receiver } from "std:sync";
import { channel } from "std:sync";
function produce(tx: Sender<i64>, n: i64) {
  var i = 1;
  while i <= n { tx.send(i * i); i = i + 1; }
}
function consume(rx: Receiver<i64>, n: i64): Future<i64> async {
  var total = 0;
  var i = 0;
  while i < n {
    var v = await rx.recv();
    total = total + v;
    i = i + 1;
  }
  total
}
function main(): Future<null> async {
  var ends = channel<i64>();
  var tx = ends.0;
  var rx = ends.1;
  var worker: JoinHandle<null> = Thread.spawn(() => produce(tx, 4));
  var total: i64 = await consume(rx, 4);
  println("sum=${total}");
}
