//@ kind: run
//@ serial
//@ description: a Thread.spawn producer sends then drops its sender; an async consumer awaits recv() and stops on ChannelClosed
//@ stdout:
//~ sum=30
import { println } from "std:io";
import { Future } from "core:prelude";
import { Thread, JoinHandle, Joined, Panicked } from "std:thread";
import { Sender, Receiver, ChannelClosed } from "std:sync";
import { channel } from "std:sync";
function produce(tx: Sender<i64>, n: i64) {
  var i = 1;
  while i <= n { tx.send(i * i); i = i + 1; }
}
function consume(rx: Receiver<i64>): Future<i64> async {
  var total = 0;
  var run = true;
  while run {
    var v: i64 | ChannelClosed = await rx.recv();
    match v {
      i64 x => { total = total + x; },
      ChannelClosed c => { run = false; },
    }
  }
  total
}
function main(): Future<null> async {
  var ends = channel<i64>();
  var tx = ends.0;
  var rx = ends.1;
  // The worker drops its captured `tx` on return, closing the channel; the
  // consumer drains 1+4+9+16 and then observes ChannelClosed.
  var worker: JoinHandle<null> = Thread.spawn(() => produce(tx, 4));
  var total: i64 = await consume(rx);
  println("sum=${total}");
}
