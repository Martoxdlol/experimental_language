//@ kind: run
//@ serial
//@ description: cancelling a pending timeout(sleep(...), ...) future unregisters both the timeout timer and the inner sleep future
//@ stdout:
//~ timeout future cancelled

import { Future } from "core:prelude";
import { println } from "std:io";
import { sleep, timeout, TimedOut } from "std:async";

function main(): Future<null> async {
  var fut = timeout(sleep(1000), 1000);
  var _started = await sleep(10);
  fut.cancel();
  var _settled = await sleep(10);
  await println("timeout future cancelled");
  null
}
