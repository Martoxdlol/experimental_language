//@ kind: run
//@ serial
//@ description: spawn many threads (each capturing a fresh binding), await each join, accumulate
//@ stdout:
//~ 45
import { List } from "core:collections";
import { println } from "std:io";
import { Future } from "core:prelude";
import { Thread, JoinHandle, Joined, Panicked } from "std:thread";
function ident(n: i64): i64 { n }
// Each spawn captures `n` (a fresh parameter binding), never the loop variable.
function spawn_one(n: i64): JoinHandle<i64> { Thread.spawn(() => ident(n)) }
function value_of(r: Joined<i64> | Panicked): i64 {
  match r { Joined<i64> j => j.value, Panicked p => 0 }
}
function gather(handles: List<JoinHandle<i64>>): Future<i64> async {
  var total = 0;
  for h in handles {
    var r: Joined<i64> | Panicked = await h.join();
    total = total + value_of(r);
  }
  total
}
function main(): Future<null> async {
  var handles: List<JoinHandle<i64>> = [];
  var i = 0;
  while i < 10 { handles.push(spawn_one(i)); i = i + 1; }
  var total: i64 = await gather(handles);
  println("${total}");
}
