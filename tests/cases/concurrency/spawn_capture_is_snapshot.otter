//@ kind: run
//@ serial
//@ description: Thread.spawn captures are independent by-value snapshots taken at the spawn site (docs/20 §6 cross-thread isolation) — mutating the captured variable afterwards does not affect the spawned task
//@ stdout:
//~ 1
import { println } from "std:io";
import { Future } from "core:prelude";
import { Thread, JoinHandle, Joined, Panicked } from "std:thread";
function ident(n: i64): i64 { n }
function main(): Future<null> async {
  var x = 1;
  // The closure captures `x` by value — a snapshot of `1` taken now.
  var h = Thread.spawn(() => ident(x));
  // Reassigning `x` after the spawn must NOT be observed by the worker.
  x = 99;
  var r: Joined<i64> | Panicked = await h.join();
  println("${match r { Joined<i64> j => j.value, Panicked p => 0 }}");
}
