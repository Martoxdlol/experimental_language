//@ kind: run
//@ serial
//@ description: cancelling a suspended Task.spawn async worker drops its state machine and releases a captured Sender endpoint, closing the channel promptly
//@ stdout:
//~ recv = closed

import { println } from "std:io";
import { Future } from "core:prelude";
import { Task, JoinHandle } from "std:task";
import { Sender, Receiver, ChannelClosed, channel } from "std:sync";
import { sleep } from "std:async";

function make_cancelled_receiver(): Receiver<i64> {
  var ends = channel<i64>();
  var tx: Sender<i64> = ends.0;
  var rx: Receiver<i64> = ends.1;
  var h: JoinHandle<i64> = Task.spawn(() async => {
      var _ = await sleep(1000);
      tx.send(1);
      1
    });
  h.cancel();
  rx
}

function main(): Future<null> async {
  var rx = make_cancelled_receiver();
  match await rx.recv() {
    i64 n => println("recv = value ${n }"),
    ChannelClosed c => println("recv = closed"),
  };
}
