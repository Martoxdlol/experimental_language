//@ kind: run
//@ serial
//@ env: OTTER_FUSION_TASK_WORKERS=4
//@ env: OTTER_FUSION_GC=stress
//@ description: many Task.spawn workers keep managed List locals live across awaits while stress GC runs on a small M:N executor
//@ stdout:
//~ total=98688
import { println } from "std:io";
import { Future } from "core:prelude";
import { List } from "core:collections";
import { Task, JoinHandle, Joined, Panicked, Cancelled } from "std:task";
import { yield_now } from "std:async";

function joined_value(r: Joined<i64> | Panicked | Cancelled): i64 {
  match r {
    Joined<i64> j => j.value,
    Panicked p => -1,
    Cancelled c => -2,
  }
}

function main(): Future<null> async {
  var handles: List<JoinHandle<i64>> = [];
  var i: i64 = 0;
  while i < 256 {
    var n = i;
    handles.push(Task.spawn(() async => {
      var local: i64 = 0;
      var round: i64 = 0;
      while round < 3 {
        var junk: List<i64> = [n, round, n + round];
        var _ = await yield_now();
        local = local + junk[0] + junk[1];
        round = round + 1;
      }
      local
    }));
    i = i + 1;
  }

  var total: i64 = 0;
  var j: i64 = 0;
  while j < handles.size() {
    total = total + joined_value(await handles[j].join());
    j = j + 1;
  }

  println("total=${total}");
}
