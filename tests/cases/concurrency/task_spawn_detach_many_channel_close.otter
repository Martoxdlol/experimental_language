//@ kind: run
//@ serial
//@ env: OTTER_FUSION_TASK_WORKERS=4
//@ description: many detached Task.spawn workers run on the M:N executor and release captured Sender endpoints so the receiver closes
//@ stdout:
//~ count=1024 total=523776 closed=1

import { println } from "std:io";
import { Future } from "core:prelude";
import { Task } from "std:task";
import { Receiver, ChannelClosed, channel } from "std:sync";
import { yield_now } from "std:async";

function spawn_detached_fanout(): Receiver<i64> {
  var ends = channel<i64>();
  var tx = ends.0;
  var rx = ends.1;

  var i: i64 = 0;
  while i < 1024 {
    var tx_i = tx.clone();
    var n = i;
    Task.spawn(() async => {
        var _a = await yield_now();
        var _b = await yield_now();
        tx_i.send(n);
        0
      }).detach();
    i = i + 1;
  }

  rx
}

function main(): Future<null> async {
  var rx = spawn_detached_fanout();
  var count: i64 = 0;
  var total: i64 = 0;
  var closed: i64 = 0;
  while closed == 0 {
    match await rx.recv() {
      i64 value => {
        count = count + 1;
        total = total + value;
      },
      ChannelClosed c => {
        closed = 1;
      },
    }
  }
  println("count=${count } total=${total } closed=${closed }");
}
