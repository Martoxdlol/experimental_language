//@ kind: run
//@ serial
//@ env: OTTER_FUSION_TASK_WORKERS=4
//@ description: many spawn-keyword executor tasks sleep concurrently and are woken by the shared timer/reactor driver
//@ stdout:
//~ total=523776
import { Future } from "core:prelude";
import { println } from "std:io";
import { List } from "core:collections";
import { sleep } from "std:async";

function work(n: i64): Future<i64> async {
  var _ = await sleep(1);
  n
}

function main(): Future<null> async {
  var handles: List<Future<i64>> = [];
  var i: i64 = 0;
  while i < 1024 {
    handles.push(spawn work(i));
    i = i + 1;
  }

  var total: i64 = 0;
  var j: i64 = 0;
  while j < handles.size() {
    total = total+await handles[j];
    j = j + 1;
  }

  await println("total=${total}");
  null
}
