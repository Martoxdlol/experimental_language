//@ kind: run
//@ serial
//@ description: many Task.spawn async workers with staggered sleep deadlines all resume on the shared timer/executor and join deterministically
//@ stdout:
//~ total=990

import { Future } from "core:prelude";
import { println } from "std:io";
import { List } from "core:collections";
import { Task, JoinHandle, Joined, Panicked, Cancelled } from "std:task";
import { sleep, yield_now } from "std:async";

function joined_value(r: Joined<i64> | Panicked | Cancelled): i64 {
  match r {
    Joined<i64> j => j.value,
    Panicked p => -1,
    Cancelled c => -2,
  }
}

function delay_for(n: i64): i64 {
  if n < 15 { 3 }
  else if n < 30 { 1 }
  else { 2 }
}

function main(): Future<null> async {
  var handles: List<JoinHandle<i64>> = [];
  var i: i64 = 0;
  while i < 45 {
    var n = i;
    handles.push(Task.spawn(() async => {
          var _first = await yield_now();
          var _second = await sleep(delay_for(n));
          n
        }));
    i = i + 1;
  }

  var total: i64 = 0;
  var j: i64 = 0;
  while j < handles.size() {
    total = total + joined_value(await handles[j].join());
    j = j + 1;
  }

  await println("total=${total}");
  null
}
