//@ kind: run
//@ serial
//@ env: OTTER_FUSION_GC=stress
//@ description: receiver endpoints returned inside tuples stay valid when copied into lists under stress GC
//@ stdout:
//~ sum=8128

import { println } from "std:io";
import { Future } from "core:prelude";
import { List } from "core:collections";
import { Sender, Receiver, ChannelClosed, channel } from "std:sync";

function make_receiver(n: i64): (Receiver<i64>, i64) {
  var ends = channel<i64>();
  var tx: Sender<i64> = ends.0;
  tx.send(n);
  (ends.1, n)
}

function main(): Future < null > async {
  var receivers: List<Receiver<i64>> = [];
  var i: i64 = 0;
  while i < 128 {
    var pair = make_receiver(i);
    receivers.push(pair.0);
    i = i + 1;
  }

  var sum: i64 = 0;
  var j: i64 = 0;
  while j < receivers.size() {
    match await receivers[j].recv() {
      i64 n => { sum = sum + n; },
      ChannelClosed c => {},
    };
    j = j + 1;
  }

  println("sum=${sum }");
}
