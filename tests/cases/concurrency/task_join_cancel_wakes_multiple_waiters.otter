//@ kind: run
//@ serial
//@ env: OTTER_FUSION_TASK_WORKERS=4
//@ description: cancelling a suspended Task.spawn worker wakes every pending JoinHandle.join() waiter as Cancelled
//@ stdout:
//~ first=-2 second=-2 total=-4
import { println } from "std:io";
import { Future } from "core:prelude";
import { Task, JoinHandle, Joined, Panicked, Cancelled } from "std:task";
import { sleep } from "std:async";

function joined_value(r: Joined<i64> | Panicked | Cancelled): i64 {
  match r {
    Joined<i64> j => j.value,
    Panicked p => -1,
    Cancelled c => -2,
  }
}

function main(): Future<null> async {
  var h: JoinHandle<i64> = Task.spawn(() async => {
    var _ = await sleep(1000);
    42
  });

  var j1: Future<Joined<i64> | Panicked | Cancelled> = h.join();
  var j2: Future<Joined<i64> | Panicked | Cancelled> = h.join();
  var _started = await sleep(20);
  h.cancel();
  var a = joined_value(await j1);
  var b = joined_value(await j2);
  println("first=${a} second=${b} total=${a + b}");
}
