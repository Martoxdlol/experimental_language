//@ kind: run
//@ serial
//@ description: timeout() preserves a ready union payload from recv(), so an already-closed channel matches ChannelClosed instead of trapping under a nested union tag
//@ stdout:
//~ recv = closed

import { println } from "std:io";
import { Future } from "core:prelude";
import { Receiver, ChannelClosed, channel } from "std:sync";
import { timeout, TimedOut } from "std:async";

function make_receiver(): Receiver<i64> {
  var ends = channel<i64>();
  var tx = ends.0;
  var rx = ends.1;
  rx
}

function main(): Future < null > async {
  var rx = make_receiver();
  match await timeout(rx.recv(), 20) {
    i64 n => println("recv = value ${n }"),
    ChannelClosed c => println("recv = closed"),
    TimedOut t => println("recv = timed out"),
  };
}
