//@ kind: run
//@ serial
//@ description: Task.spawn JoinHandle.cancel cooperatively cancels a suspended executor task, joins as Cancelled, and releases held Shared locks
//@ stdout:
//~ join = cancelled
//~ after cancel = 1
import { Future } from "core:prelude";
import { println } from "std:io";
import { Task, JoinHandle, Joined, Panicked, Cancelled } from "std:task";
import { Shared, LockBusy } from "std:sync";
import { sleep } from "std:async";

struct C { value: i64 }

function main(): Future<null> async {
  var state: Shared<C> = Shared.new(C { value: 0 });
  var s: Shared<C> = state.clone();
  var h: JoinHandle<i64> = Task.spawn(() async => {
      await s.lock((c) async => {
          c.value = 1;
          var _ = await sleep(1000);
          c.value = 2;
          c.value
        })
    });

  var _started = await sleep(20);
  h.cancel();
  match await h.join() {
    Joined<i64> j => await println("join = joined ${j.value}"),
    Panicked p => await println("join = panicked"),
    Cancelled c => await println("join = cancelled"),
  };
  match await state.try_lock((c) => c.value) {
    i64 n => await println("after cancel = ${n}"),
    LockBusy b => await println("after cancel = still locked"),
  };
  null
}
