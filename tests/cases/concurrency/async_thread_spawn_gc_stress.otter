//@ kind: run
//@ serial
//@ env: OTTER_FUSION_GC=stress
//@ description: async `Thread.spawn` workers build heap garbage and lock a Shared while the GC collects aggressively; precise roots across the worker's await/drive path must keep the shared cell alive (docs/16, docs/20 §1/§4)
//@ stdout:
//~ total = 600
import { List } from "core:collections";
import { println } from "std:io";
import { Future } from "core:prelude";
import { Shared } from "std:sync";
import { Thread, JoinHandle, Joined, Panicked } from "std:thread";
struct C { value: i64 }
function main(): Future<null> async {
  var state: Shared<C> = Shared.new(C { value: 0 });
  var handles: List<JoinHandle<i64>> = [];
  var t = 0;
  while t < 6 {
    var s: Shared<C> = state.clone();
    handles.push(Thread.spawn(() async => {
      var i: i64 = 0;
      while i < 100 {
        // Allocate garbage each iteration to provoke collections mid-drive.
        var junk: List<i64> = [i, i + 1, i + 2];
        await s.lock((c) => { c.value = c.value + junk[0] - junk[0] + 1; 0 });
        i = i + 1;
      }
      0
    }));
    t = t + 1;
  }
  for h in handles {
    var _ = await h.join();
  }
  var total: i64 = await state.lock((c) => c.value);
  println("total = ${total}");
}
