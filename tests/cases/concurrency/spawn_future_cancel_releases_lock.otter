//@ kind: run
//@ serial
//@ description: cancelling a spawn EXPR future stops the executor task and releases a Shared lock held across an await
//@ stdout:
//~ after cancel = 1
import { println } from "std:io";
import { Future } from "core:prelude";
import { Shared, LockBusy } from "std:sync";
import { sleep } from "std:async";
struct C { value: i64 }
function hold_lock(state: Shared<C>): Future < null > async {
  await state.lock((c)async => {
      c.value = 1;
      var _ = await sleep(1000);
      c.value = 2;
      0
    });
  null
}
function main(): Future < null > async {
  var state: Shared<C> = Shared.new(C { value: 0 });
  var s: Shared<C> = state.clone();
  var fut: Future < null > = spawn hold_lock(s);
  var started = await sleep(20);
  fut.cancel();
  var _ = await sleep(5);
  match await state.try_lock((c) => c.value) {
    i64 n => println("after cancel = ${n }"),
    LockBusy b => println("after cancel = still locked"),
  };
}
