//@ kind: run
//@ serial
//@ description: an async `Thread.spawn` worker consumes a cross-thread channel with `await rx.recv()` until the producer drops its sender; the joined sum proves the awaited result crosses the worker boundary (docs/20 §1, docs/21 §6)
//@ stdout:
//~ sum=30
import { println } from "std:io";
import { Future } from "core:prelude";
import { Thread, JoinHandle, Joined, Panicked } from "std:thread";
import { Sender, Receiver, ChannelClosed, channel } from "std:sync";
function produce(tx: Sender<i64>, n: i64) {
  var i = 1;
  while i <= n { tx.send(i * i); i = i + 1; }
}
function value_of(r: Joined<i64> | Panicked): i64 {
  match r { Joined<i64> j => j.value, Panicked p => -1 }
}
function main(): Future<null> async {
  var ends = channel<i64>();
  var tx = ends.0;
  var rx = ends.1;
  // The async worker awaits each recv; when the synchronous producer drops its
  // sender the channel closes and the worker returns its accumulated sum.
  var worker: JoinHandle<i64> = Thread.spawn(() async => {
    var total = 0;
    var run = true;
    while run {
      var v: i64 | ChannelClosed = await rx.recv();
      match v {
        i64 x => { total = total + x; },
        ChannelClosed c => { run = false; },
      }
    }
    total
  });
  var feeder: JoinHandle<null> = Thread.spawn(() => produce(tx, 4));
  var _ = await feeder.join();
  var r: Joined<i64> | Panicked = await worker.join();
  println("sum=${value_of(r)}");
}
