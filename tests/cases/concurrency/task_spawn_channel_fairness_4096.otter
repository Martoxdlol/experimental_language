//@ kind: run
//@ serial
//@ env: OTTER_FUSION_TASK_WORKERS=2
//@ description: 4096 unevenly-yielding Task.spawn workers all make progress, send through cloned channel endpoints, and join on a small M:N executor
//@ stdout:
//~ received=8386560 joined=8386560

import { println } from "std:io";
import { Future } from "core:prelude";
import { List } from "core:collections";
import { Task, JoinHandle, Joined, Panicked, Cancelled } from "std:task";
import { Sender, Receiver, ChannelClosed, channel } from "std:sync";
import { yield_now } from "std:async";

function joined_value(r: Joined<i64> | Panicked | Cancelled): i64 {
  match r {
    Joined<i64> j => j.value,
    Panicked p => -1,
    Cancelled c => -2,
  }
}

function main(): Future<null> async {
  var ends = channel<i64>();
  var tx: Sender<i64> = ends.0;
  var rx: Receiver<i64> = ends.1;
  var handles: List<JoinHandle<i64>> = [];

  var i: i64 = 0;
  while i < 4096 {
    var n = i;
    var tx_i = tx.clone();
    handles.push(Task.spawn(() async => {
      var rounds: i64 = (n % 7) + 1;
      var r: i64 = 0;
      while r < rounds {
        var _ = await yield_now();
        r = r + 1;
      }
      tx_i.send(n);
      n
    }));
    i = i + 1;
  }

  var received: i64 = 0;
  var count: i64 = 0;
  while count < 4096 {
    match await rx.recv() {
      i64 value => { received = received + value; },
      ChannelClosed c => { received = -999999; },
    }
    count = count + 1;
  }

  var joined: i64 = 0;
  for h in handles {
    joined = joined + joined_value(await h.join());
  }

  println("received=${received} joined=${joined}");
}
