//@ kind: compile-error
//@ stderr: escape
import { List } from "core:collections";
import { println } from "std:io";
import { Future } from "core:prelude";
import { Shared } from "std:sync";
struct X { value: i64 }
struct Counter { x: X }
function main(): Future<null> async {
  var state: Shared<Counter> = Shared.new(Counter { x: X { value: 0 } });
  var sink: List<X> = [];
  await state.lock((c) => { c.x.value = 1; sink.push(c.x); 0 }); // alias stored in outer list
  sink[0].value = -1; // mutating the shared cell through the escaped alias
  var snap: i64 = await state.lock((c) => c.x.value);
  println("snap = " + (snap as str));
}
