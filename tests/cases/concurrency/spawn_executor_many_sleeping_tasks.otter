//@ kind: run
//@ serial
//@ description: many executor tasks sleeping concurrently are woken by the shared timer driver
//@ stdout:
//~ total=780
import { println } from "std:io";
import { Future } from "core:prelude";
import { List } from "core:collections";
import { sleep } from "std:async";

function work(n: i64): Future<i64> async {
  var _ = await sleep(1);
  n
}

function main(): Future<null> async {
  var handles: List<Future<i64>> = [];
  var i: i64 = 0;
  while i < 40 {
    handles.push(spawn work(i));
    i = i + 1;
  }
  var total: i64 = 0;
  var j: i64 = 0;
  while j < handles.size() {
    total = total + await handles[j];
    j = j + 1;
  }
  println("total=${total}");
}
