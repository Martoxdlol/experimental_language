//@ kind: run
//@ serial
//@ env: OTTER_FUSION_TASK_WORKERS=4
//@ description: Task.spawn panics surface as Panicked on join while sibling executor tasks still complete
//@ stdout:
//~ ordinary panic: ordinary boom
//~ async panic: async boom
//~ ok joined: 99

import { println } from "std:io";
import { Future, panic } from "core:prelude";
import { Task, JoinHandle, Joined, Panicked, Cancelled } from "std:task";
import { yield_now } from "std:async";

function show(label: str, r: Joined<i64> | Panicked | Cancelled): Future<null> async {
  match r {
    Joined<i64> j => await println(label + " joined: " + (j.value as str)),
    Panicked p => await println(label + " panic: " + p.message),
    Cancelled c => await println(label + " cancelled"),
  }
  null
}

function main(): Future<null> async {
  var ordinary_bad: JoinHandle<i64> = Task.spawn(() => {
      panic("ordinary boom");
      0
    });
  var async_bad: JoinHandle<i64> = Task.spawn(() async => {
      var _ = await yield_now();
      panic("async boom");
      0
    });
  var ok: JoinHandle<i64> = Task.spawn(() async => {
      var _ = await yield_now();
      99
    });

  await show("ordinary", await ordinary_bad.join());
  await show("async", await async_bad.join());
  await show("ok", await ok.join());
  null
}
