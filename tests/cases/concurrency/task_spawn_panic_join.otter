//@ kind: run
//@ serial
//@ env: OTTER_FUSION_TASK_WORKERS=4
//@ description: Task.spawn panics surface as Panicked on join while sibling executor tasks still complete
//@ stdout:
//~ sync panic: sync boom
//~ async panic: async boom
//~ ok joined: 99

import { println } from "std:io";
import { Future, panic } from "core:prelude";
import { Task, JoinHandle, Joined, Panicked, Cancelled } from "std:task";
import { yield_now } from "std:async";

function show(label: str, r: Joined<i64> | Panicked | Cancelled) {
  match r {
    Joined<i64> j => println(label + " joined: " + (j.value as str)),
    Panicked p => println(label + " panic: " + p.message),
    Cancelled c => println(label + " cancelled"),
  }
}

function main(): Future<null> async {
  var sync_bad: JoinHandle<i64> = Task.spawn(() => {
    panic("sync boom");
    0
  });
  var async_bad: JoinHandle<i64> = Task.spawn(() async => {
    var _ = await yield_now();
    panic("async boom");
    0
  });
  var ok: JoinHandle<i64> = Task.spawn(() async => {
    var _ = await yield_now();
    99
  });

  show("sync", await sync_bad.join());
  show("async", await async_bad.join());
  show("ok", await ok.join());
}
