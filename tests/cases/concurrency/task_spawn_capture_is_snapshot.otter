//@ kind: run
//@ serial
//@ description: Task.spawn captures are independent by-value snapshots for both ordinary non-async and async closures; later parent mutations are not observed by executor tasks
//@ stdout:
//~ ordinary=1 async=2

import { Future } from "core:prelude";
import { println } from "std:io";
import { Task, JoinHandle, Joined, Panicked, Cancelled } from "std:task";
import { yield_now } from "std:async";

function joined_value(r: Joined<i64> | Panicked | Cancelled): i64 {
  match r {
    Joined<i64> j => j.value,
    Panicked p => -1,
    Cancelled c => -2,
  }
}

function main(): Future<null> async {
  var ordinary_x = 1;
  var async_x = 2;
  var ordinary_h: JoinHandle<i64> = Task.spawn(() => ordinary_x);
  var async_h: JoinHandle<i64> = Task.spawn(() async => {
      var _ = await yield_now();
      async_x
    });

  ordinary_x = 99;
  async_x = 100;

  var ordinary_value: i64 = joined_value(await ordinary_h.join());
  var async_value: i64 = joined_value(await async_h.join());
  await println("ordinary=${ordinary_value} async=${async_value}");
  null
}
