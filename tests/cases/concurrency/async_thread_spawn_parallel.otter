//@ kind: run
//@ serial
//@ description: four parallel async `Thread.spawn` workers each clone the handle and increment under the async lock 100 times; the mutex serializes every write so the joined total is exact with no lost updates (docs/20 §1/§4)
//@ stdout:
//~ total = 400
import { List } from "core:collections";
import { println } from "std:io";
import { Future } from "core:prelude";
import { Shared } from "std:sync";
import { Thread, JoinHandle, Joined, Panicked } from "std:thread";
struct C { value: i64 }
function main(): Future<null> async {
  var state: Shared<C> = Shared.new(C { value: 0 });
  var handles: List<JoinHandle<i64>> = [];
  var t = 0;
  while t < 4 {
    var s: Shared<C> = state.clone();
    // Each async worker drives its own future on its own OS thread.
    handles.push(Thread.spawn(() async => {
          var i: i64 = 0;
          while i < 100 {
            await s.lock((c) => { c.value = c.value + 1; 0 });
            i = i + 1;
          }
          0
        }));
    t = t + 1;
  }
  for h in handles {
    var _ = await h.join();
  }
  var total: i64 = await state.lock((c) => c.value);
  println("total = ${total }");
}
