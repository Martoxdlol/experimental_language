//@ kind: run
//@ serial
//@ env: OTTER_FUSION_TASK_WORKERS=4
//@ description: timing out a Task.spawn JoinHandle.join() future cancels only that waiter; the executor task keeps running and can be joined later
//@ stdout:
//~ first = timed out
//~ second = joined 42
import { Future } from "core:prelude";
import { println } from "std:io";
import { Task, JoinHandle, Joined, Panicked, Cancelled } from "std:task";
import { sleep, timeout, TimedOut } from "std:async";

function main(): Future<null> async {
  var h: JoinHandle<i64> = Task.spawn(() async => {
      var _ = await sleep(40);
      42
    });

  match await timeout(h.join(), 5) {
    Joined<i64> j => await println("first = joined ${j.value}"),
    Panicked p => await println("first = panicked"),
    Cancelled c => await println("first = cancelled"),
    TimedOut t => await println("first = timed out"),
  };

  var _settled = await sleep(60);
  match await h.join() {
    Joined<i64> j => await println("second = joined ${j.value}"),
    Panicked p => await println("second = panicked"),
    Cancelled c => await println("second = cancelled"),
  };
  null
}
