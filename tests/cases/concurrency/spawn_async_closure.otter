//@ kind: run
//@ serial
//@ description: `spawn EXPR` over an async-closure call — calling the closure builds the future (capturing `base`), spawn hands it to a worker, awaiting the handle resolves to the result (docs/21 §6–§7)
//@ stdout:
//~ v=57
import { println } from "std:io";
import { Future } from "core:prelude";
import { sleep } from "std:async";
function main(): Future<null> async {
  var base: i64 = 50;
  var work = function(x: i64): Future<i64> async { var _ = await sleep(1); base + x };
  var h: Future<i64> = spawn work(7);
  println("v=${await h}");
}
