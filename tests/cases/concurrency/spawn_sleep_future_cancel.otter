//@ kind: run
//@ serial
//@ description: cancelling a spawn sleep() future cleans the runtime timer future instead of treating its marker as a generated cleanup hook
//@ stdout:
//~ spawn sleep cancelled

import { println } from "std:io";
import { Future } from "core:prelude";
import { sleep } from "std:async";

function main(): Future < null > async {
  var fut = spawn sleep(1000);
  var _started = await sleep(10);
  fut.cancel();
  var _settled = await sleep(10);
  println("spawn sleep cancelled");
}
