//@ kind: run
//@ serial
//@ description: cancelling an ordinary non-async Task.spawn closure is cooperative and cannot force a Cancelled result because the body has no await suspension point
//@ stdout:
//~ ordinary cancel = joined 42

import { Future } from "core:prelude";
import { println } from "std:io";
import { Task, JoinHandle, Joined, Panicked, Cancelled } from "std:task";

function main(): Future<null> async {
  var h: JoinHandle<i64> = Task.spawn(() => 42);
  h.cancel();
  match await h.join() {
    Joined<i64> j => await println("ordinary cancel = joined ${j.value}"),
    Panicked p => await println("ordinary cancel = panicked"),
    Cancelled c => await println("ordinary cancel = cancelled"),
  };
  null
}
