//@ kind: run
//@ serial
//@ env: OTTER_FUSION_GC=stress
//@ description: Task.spawn workers allocate managed garbage and lock Shared while stress GC runs across executor worker safepoints
//@ stdout:
//~ total = 10
import { List } from "core:collections";
import { println } from "std:io";
import { Future } from "core:prelude";
import { Shared } from "std:sync";
import { Task, JoinHandle, Joined, Panicked, Cancelled } from "std:task";

struct C { value: i64 }

function ok(r: Joined<i64> | Panicked | Cancelled): i64 {
  match r {
    Joined<i64> j => j.value,
    Panicked p => -1,
    Cancelled c => -2,
  }
}

function main(): Future<null> async {
  var state: Shared<C> = Shared.new(C { value: 0 });
  var handles: List<JoinHandle<i64>> = [];
  var t = 0;
  while t < 2 {
    var s: Shared<C> = state.clone();
    handles.push(Task.spawn(() async => {
          var i: i64 = 0;
          while i < 5 {
            var junk: List<i64> = [i, i + 1, i + 2];
            await s.lock((c) => { c.value = c.value + junk[0] - junk[0] + 1; 0 });
            i = i + 1;
          }
          0
        }));
    t = t + 1;
  }
  for h in handles {
    var _ = ok(await h.join());
  }
  var total: i64 = await state.lock((c) => c.value);
  println("total = ${total }");
}
