//@ kind: run
//@ serial
//@ env: OTTER_FUSION_GC=stress
//@ description: heavy concurrent allocation exercises true concurrent reclamation (world-barrier STW)
//@ stdout:
// Each worker builds and discards many lists/strings in a loop, producing
// garbage the collector reclaims mid-run while other workers keep mutating.
// Before the world barrier this deterministically use-after-freed (SIGSEGV);
// it must now run clean and produce the exact, schedule-independent total.
//~ 31740
import { println } from "std:io";
import { List } from "core:collections";
import { Future } from "core:prelude";
import { Thread, JoinHandle, Joined, Panicked } from "std:thread";

function churn(seed: i64): i64 {
  var acc = 0;
  var i = 0;
  while i < 300 {
    var xs: List<i64> = [];
    var j = 0;
    while j < 10 { xs.push(i + j + seed); j = j + 1; }
    var s = "v=${xs.size() }-${i }";
    acc = acc + xs.size() + s.size();
    i = i + 1;
  }
  acc
}

function value_of(r: Joined<i64> | Panicked): i64 {
  match r { Joined<i64> j => j.value, Panicked p => 0 }
}

function gather(handles: List<JoinHandle<i64>>): Future<i64> async {
  var total = 0;
  for h in handles {
    var r: Joined<i64> | Panicked = await h.join();
    total = total + value_of(r);
  }
  total
}

function main(): Future<null> async {
  var handles: List<JoinHandle<i64>> = [];
  var i = 0;
  // Every worker runs the same seed-independent total, so the sum is exact and
  // deterministic regardless of scheduling: 6 workers × churn(_) .
  while i < 6 { handles.push(Thread.spawn(() => churn(0))); i = i + 1; }
  var total: i64 = await gather(handles);
  println("${total }");
}
