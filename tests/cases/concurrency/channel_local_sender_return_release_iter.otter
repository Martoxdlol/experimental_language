//@ kind: run
//@ serial
//@ description: returning a Receiver releases a local Sender endpoint and async channel iteration terminates
//@ stdout:
//~ done

import { Future } from "core:prelude";
import { println } from "std:io";
import { Receiver, channel } from "std:sync";

function make_receiver(): Receiver<i64> {
  var ends = channel<i64>();
  var tx = ends.0;
  var rx = ends.1;
  rx
}

function main(): Future<null> async {
  var rx = make_receiver();
  for await n in rx {
    await println("value ${n}");
  }
  await println("done");
  null
}
