//@ kind: run
//@ serial
//@ env: OTTER_FUSION_TASK_WORKERS=4
//@ env: OTTER_FUSION_GC=stress
//@ description: spawn keyword futures return managed List graphs at fanout under stress GC and the awaiter consumes every result
//@ stdout:
//~ total=33280
import { Future } from "core:prelude";
import { println } from "std:io";
import { List } from "core:collections";
import { yield_now } from "std:async";

function build_list(n: i64): Future<List<i64>> async {
  var churn: i64 = 0;
  while churn < 8 {
    var garbage: List<i64> = [n, churn, n + churn];
    var _ = await yield_now();
    churn = churn + garbage.size();
  }

  var out: List<i64> = [];
  var i: i64 = 0;
  while i < 4 {
    out.push(n + i);
    i = i + 1;
  }
  out
}

function sum_list(xs: List<i64>): i64 {
  var total: i64 = 0;
  for value in xs {
    total = total + value;
  }
  total
}

function main(): Future<null> async {
  var handles: List<Future<List<i64>>> = [];
  var i: i64 = 0;
  while i < 128 {
    handles.push(spawn build_list(i));
    i = i + 1;
  }

  var total: i64 = 0;
  var j: i64 = 0;
  while j < handles.size() {
    total = total + sum_list(await handles[j]);
    j = j + 1;
  }

  await println("total=${total}");
  null
}
