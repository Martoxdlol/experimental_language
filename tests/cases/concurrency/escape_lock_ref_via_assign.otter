//@ kind: compile-error
//@ known-bug: docs/20 §4 detachment rule — assigning a live lock reference (here the sub-field `c.x`) to an outer-scoped variable must be rejected by escape analysis; only a `.clone()` may leave the lock. Escape analysis is not yet implemented, so this currently compiles and runs (racily, when threaded), instead of erroring.
//@ stderr: escape
import { println } from "std:io";
import { Shared } from "std:sync";
struct X { value: i64 }
struct Counter { x: X }
function main() {
  var state: Shared<Counter> = Shared.new(Counter { x: X { value: 0 } });
  var escaped: X | null = null;
  // `c.x` is a live reference into the locked cell; storing it in `escaped`
  // (declared outside the lock body) lets it be mutated after the lock releases.
  state.lock((c) => { c.x.value = c.x.value + 1; escaped = c.x; 0 });
  (escaped as X).value = -1; // unsynchronized write into the shared cell
  var snap: i64 = state.lock((c) => c.x.value);
  println("snap = " + (snap as str));
}
