//@ kind: run
//@ serial
//@ env: OTTER_FUSION_TASK_WORKERS=4
//@ description: the spawn keyword sustains 4096 yielding async tasks on a small M:N executor and awaits every Future handle
//@ stdout:
//~ total=8386560
import { Future } from "core:prelude";
import { println } from "std:io";
import { List } from "core:collections";
import { yield_now } from "std:async";

function work(n: i64): Future<i64> async {
  var _a = await yield_now();
  var _b = await yield_now();
  n
}

function main(): Future<null> async {
  var handles: List<Future<i64>> = [];
  var i: i64 = 0;
  while i < 4096 {
    handles.push(spawn work(i));
    i = i + 1;
  }

  var total: i64 = 0;
  var j: i64 = 0;
  while j < handles.size() {
    total = total+await handles[j];
    j = j + 1;
  }

  await println("total=${total}");
  null
}
