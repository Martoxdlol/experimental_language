//@ kind: compile-error
//@ description: Shared.lock awaits the body until it resolves and produces the body value; awaiting that resolved value again is rejected
//@ stderr: `await` requires a `Future`

import { Future } from "core:prelude";
import { Shared } from "std:sync";

function main(): Future<null> async {
  var state = Shared.new(1);
  var value: i64 = await state.lock((current: i64): i64 => current + 1);
  var _again = await value;
  null
}
