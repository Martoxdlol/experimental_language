//@ kind: run
//@ serial
//@ description: when the last Receiver is dropped the channel is closed for sending; a subsequent `send` returns `ChannelClosed` instead of enqueuing a message nobody can ever observe (docs/20 §2, docs/16 §8)
//@ stdout:
//~ drained
//~ closed=true
import { println } from "std:io";
import { Future } from "core:prelude";
import { Thread, JoinHandle, Joined, Panicked } from "std:thread";
import { Sender, Receiver, ChannelClosed } from "std:sync";
import { channel } from "std:sync";

// Captures the receiver and immediately returns, releasing it — the channel is
// now closed for sending.
function drain(rx: Receiver<i64>): i64 { 0 }

function main(): Future<null> async {
  var ends = channel<i64>();
  var tx = ends.0;
  var rx = ends.1;
  var h: JoinHandle<i64> = Thread.spawn(() => { drain(rx); 0 });
  // Wait for the worker (and thus the receiver release) to complete.
  var _r: Joined<i64> | Panicked = await h.join();
  println("drained");
  var closed = false;
  var result: null | ChannelClosed = tx.send(99);
  match result {
    ChannelClosed c => { closed = true; },
    null => {},
  }
  println("closed=${closed}");
}
