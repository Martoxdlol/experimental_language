//@ kind: run
//@ serial
//@ env: OTTER_FUSION_GC=stress
//@ description: worker-panic isolation holds under GC stress — a worker that allocates heavily and then panics leaves the heap/roots consistent (its abandoned objects become collectable, not pinned), while sibling workers allocating concurrently finish correctly (docs/16 panic row, docs/20 §1).
//@ stdout:
//~ p0 = panicked: boom 0
//~ p1 = ok 4950
//~ p2 = panicked: boom 2
//~ p3 = ok 4950
//~ survived
import { println } from "std:io";
import { Future, panic } from "core:prelude";
import { List } from "core:collections";
import { Thread, JoinHandle, Joined, Panicked } from "std:thread";

// Allocate a bunch of strings/lists, then either return a sum or panic — so the
// panic happens with live managed temporaries on the worker's stack.
function churn(id: i64, doom: bool): i64 {
  var xs: List<i64> = [];
  var i: i64 = 0;
  while i < 100 {
    var s: str = "item ${id } ${i }";
    if s.size() > 0 { xs.push(i); }
    i = i + 1;
  }
  var total: i64 = 0;
  for v in xs { total = total + v; }
  if doom { panic("boom " + (id as str)); }
  total
}

function show(label: str, r: Joined<i64> | Panicked) {
  match r {
    Joined < i64 > j => println(label + " = ok " + (j.value as str)),
    Panicked p => println(label + " = panicked: " + p.message),
  };
}

function main(): Future < null > async {
  var h0: JoinHandle<i64> = Thread.spawn(() => churn(0, true));
  var h1: JoinHandle<i64> = Thread.spawn(() => churn(1, false));
  var h2: JoinHandle<i64> = Thread.spawn(() => churn(2, true));
  var h3: JoinHandle<i64> = Thread.spawn(() => churn(3, false));
  show("p0", await h0.join());
  show("p1", await h1.join());
  show("p2", await h2.join());
  show("p3", await h3.join());
  println("survived");
}
