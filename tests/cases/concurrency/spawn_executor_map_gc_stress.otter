//@ kind: run
//@ serial
//@ env: OTTER_FUSION_TASK_WORKERS=4
//@ env: OTTER_FUSION_GC=stress
//@ description: spawn keyword futures keep Map locals alive across async loop safepoints and await suspensions under stress GC
//@ stdout:
//~ weights=1240 awaited=7440
import { println } from "std:io";
import { Future } from "core:prelude";
import { List, Map } from "core:collections";
import { yield_now } from "std:async";

function work(n: i64): Future<i64> async {
  var seen: Map<i64, i64> = Map<i64, i64>();
  var j: i64 = 0;
  while j < 6 {
    seen.set(j, n * 10 + j);
    var _ = await yield_now();
    j = j + 1;
  }

  var total: i64 = 0;
  var k: i64 = 0;
  while k < 6 {
    total = total + seen[k];
    k = k + 1;
  }
  total
}

function main(): Future<null> async {
  var weights: Map<i64, i64> = Map<i64, i64>();
  var handles: List<Future<i64>> = [];

  var i: i64 = 0;
  while i < 16 {
    weights.set(i, i * i);
    handles.push(spawn work(i));
    i = i + 1;
  }

  var weight_total: i64 = 0;
  var wi: i64 = 0;
  while wi < 16 {
    weight_total = weight_total + weights[wi];
    wi = wi + 1;
  }

  var awaited: i64 = 0;
  var hi: i64 = 0;
  while hi < handles.size() {
    awaited = awaited + await handles[hi];
    hi = hi + 1;
  }

  println("weights=${weight_total} awaited=${awaited}");
}
