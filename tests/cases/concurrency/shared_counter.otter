//@ kind: run
//@ serial
//@ description: Shared<T> async mutual-exclusion lock — awaiting it yields the closure's result (docs/20 §4)
//@ stdout:
//~ 15
import { Future } from "core:prelude";
import { println } from "std:io";
import { Shared, LockBusy } from "std:sync";
function main(): Future<null> async {
  var cell = Shared.new(10);
  var r = await cell.lock((v: i64): i64 => v + 5);
  await println("${r}");
  null
}
