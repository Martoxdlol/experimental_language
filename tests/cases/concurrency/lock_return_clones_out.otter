//@ kind: run
//@ description: the lock RETURN boundary clones references out (docs/20 §4 "return value cloned out") — mutating the returned value must not affect the shared cell
//@ stdout:
//~ returned = -1
//~ shared = 5
import { println } from "std:io";
import { Future } from "core:prelude";
import { Shared } from "std:sync";
import { Clone } from "core:prelude";
@Derive(Clone)
struct X { value: i64 }
@Derive(Clone)
struct Counter { x: X }
function main(): Future < null > async {
  var state: Shared<Counter> = Shared.new(Counter { x: X { value: 0 } });
  // Returning a reference detaches it: the value is cloned at the return boundary.
  var got: X = await state.lock((c) => { c.x.value = 5; c.x });
  got.value = -1;
  var snap: i64 = await state.lock((c) => c.x.value);
  println("returned = " + (got.value as str));
  println("shared = " + (snap as str));
}
