//@ kind: run
//@ serial
//@ description: a panic inside a lock body unwinds and RELEASES the lock — no poisoning (docs/20 §4). The worker's panic surfaces as Panicked on join; the cell is afterwards re-lockable and holds whatever the panicking body left behind.
//@ known-bug: depends on a known TODO — a panic in a spawned worker currently aborts the whole process (exit 101) instead of being captured as `Panicked` on join (docs/20 §1). Once thread-panic capture lands, this also asserts the §4 "panic releases the lock, no poisoning" guarantee.
//@ stdout:
//~ worker = panicked
//~ reacquired = 1
import { println } from "std:io";
import { Future, panic } from "core:prelude";
import { Thread, JoinHandle, Joined, Panicked } from "std:thread";
import { Shared, LockBusy } from "std:sync";
struct X { value: i64 }
struct Counter { x: X }
function main(): Future<null> async {
  var state: Shared<Counter> = Shared.new(Counter { x: X { value: 0 } });
  var h: JoinHandle<i64> = Thread.spawn(() => {
    state.lock((c) => { c.x.value = 1; panic("boom in body"); 0 });
    0
  });
  var r: Joined<i64> | Panicked = await h.join();
  match r {
    Joined<i64> j => println("worker = ok " + (j.value as str)),
    Panicked p => println("worker = panicked"),
  };
  // The lock must have been released during unwinding. Use try_lock so a
  // regression (lock left held) reports `still held` instead of hanging.
  match state.try_lock((c) => c.x.value) {
    i64 n => println("reacquired = " + (n as str)),
    LockBusy busy => println("reacquired = still held"),
  };
}
