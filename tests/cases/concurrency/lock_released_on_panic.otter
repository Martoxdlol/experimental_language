//@ kind: run
//@ serial
//@ description: a panic inside a `Shared` lock body unwinds to the worker's panic boundary and RELEASES the lock — no poisoning (docs/20 §4). The worker's panic surfaces as `Panicked` on `join`; the cell stays re-lockable afterwards and holds whatever the panicking body left behind (managed mutation is in-place).
//@ stdout:
//~ worker = panicked: boom in body
//~ reacquired = 1
import { println } from "std:io";
import { Future, panic } from "core:prelude";
import { Shared, LockBusy } from "std:sync";
import { Thread, JoinHandle, Joined, Panicked } from "std:thread";
struct X { value: i64 }
struct Counter { x: X }
function main(): Future < null > async {
  var state: Shared<Counter> = Shared.new(Counter { x: X { value: 0 } });
  var s: Shared<Counter> = state.clone();
  // An async worker panics while holding the lock. The panic is isolated to the
  // worker (boundary at its entry), and unwinding drains the held-lock set so
  // the lock is released — never poisoned. The worker surfaces as `Panicked`.
  var h: JoinHandle < null > = Thread.spawn(()async => {
      await s.lock((c) => { c.x.value = 1; panic("boom in body"); 0 });
      null
    });
  match await h.join() {
    Joined < null > j => println("worker = ok"),
    Panicked p => println("worker = panicked: " + p.message),
  };
  // The lock must have been released during unwinding. Use try_lock so a
  // regression (lock left held) reports `still held` instead of hanging.
  match await state.try_lock((c) => c.x.value) {
    i64 n => println("reacquired = " + (n as str)),
    LockBusy busy => println("reacquired = still held"),
  };
}
