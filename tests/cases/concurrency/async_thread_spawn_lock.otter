//@ kind: run
//@ serial
//@ description: an async `Thread.spawn` worker (`() => Future<R>`) polls its future until it resolves on its own OS thread, awaiting and locking a `Shared<T>` 50 times; the handle joins on the awaited `R` (docs/20 §1/§4)
//@ stdout:
//~ worker=50 total=50
import { Future } from "core:prelude";
import { println } from "std:io";
import { Shared } from "std:sync";
import { Thread, JoinHandle, Joined, Panicked } from "std:thread";
struct C { value: i64 }
function value_of(r: Joined<i64> | Panicked): i64 {
  match r { Joined<i64> j => j.value, Panicked p => -1 }
}
function main(): Future<null> async {
  var state: Shared<C> = Shared.new(C { value: 0 });
  var s: Shared<C> = state.clone();
  // An async worker MAY await and lock — it polls the future with a real
  // executor and waker, unlike an ordinary non-async `Thread.spawn` closure.
  var h: JoinHandle<i64> = Thread.spawn(() async => {
      var i: i64 = 0;
      while i < 50 {
        await s.lock((c) => { c.value = c.value + 1; 0 });
        i = i + 1;
      }
      await s.lock((c) => c.value)
    });
  var r: Joined<i64> | Panicked = await h.join();
  var total: i64 = await state.lock((c) => c.value);
  await println("worker=${value_of(r)} total=${total}");
  null
}
