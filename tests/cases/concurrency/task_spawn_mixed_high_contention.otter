//@ kind: run
//@ serial
//@ env: OTTER_FUSION_TASK_WORKERS=4
//@ description: hundreds of Task.spawn async workers yield, contend on Shared, send over channels, and join deterministically on the M:N executor
//@ stdout:
//~ shared=3072 received=784896 joined=784896
import { Future } from "core:prelude";
import { println } from "std:io";
import { List } from "core:collections";
import { Task, JoinHandle, Joined, Panicked, Cancelled } from "std:task";
import { Shared, Sender, Receiver, ChannelClosed, channel } from "std:sync";
import { yield_now } from "std:async";

struct Counter { value: i64 }

function joined_value(r: Joined<i64> | Panicked | Cancelled): i64 {
  match r {
    Joined<i64> j => j.value,
    Panicked p => -1,
    Cancelled c => -2,
  }
}

function main(): Future<null> async {
  var state: Shared<Counter> = Shared.new(Counter { value: 0 });
  var ends = channel<i64>();
  var tx: Sender<i64> = ends.0;
  var rx: Receiver<i64> = ends.1;
  var handles: List<JoinHandle<i64>> = [];

  var i: i64 = 0;
  while i < 512 {
    var n = i;
    var s: Shared<Counter> = state.clone();
    var tx_i: Sender<i64> = tx.clone();
    handles.push(Task.spawn(() async => {
          var local: i64 = 0;
          var round: i64 = 0;
          while round < 6 {
            var _ = await yield_now();
            await s.lock((c) => { c.value = c.value + 1; 0 });
            local = local + n;
            round = round + 1;
          }
          tx_i.send(local);
          local
        }));
    i = i + 1;
  }

  var received: i64 = 0;
  var rcount: i64 = 0;
  while rcount < 512 {
    var msg: i64 | ChannelClosed = await rx.recv();
    match msg {
      i64 value => { received = received + value; },
      ChannelClosed c => { received = -999999; },
    }
    rcount = rcount + 1;
  }

  var joined: i64 = 0;
  for h in handles {
    joined = joined + joined_value(await h.join());
  }

  var shared_total: i64 = await state.lock((c) => c.value);
  await println("shared=${shared_total} received=${received} joined=${joined}");
  null
}
