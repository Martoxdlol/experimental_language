//@ kind: run
//@ serial
//@ env: OTTER_FUSION_GC=stress
//@ description: Thread.spawn/join while the GC runs aggressively
//@ stdout:
//~ 30
import { println } from "std:io";
import { Future } from "core:prelude";
import { Thread, JoinHandle, Joined, Panicked } from "std:thread";
function sum_to(n: i64): i64 {
  var acc = 0;
  var i = 0;
  while i < n { acc = acc + i; i = i + 1; }
  acc
}
function value_of(r: Joined<i64> | Panicked): i64 {
  match r { Joined<i64> j => j.value, Panicked p => 0 }
}
function main(): Future<null> async {
  var h: JoinHandle<i64> = Thread.spawn(() => sum_to(5));
  var other = sum_to(5);
  var r: Joined<i64> | Panicked = await h.join();
  println("${value_of(r) + other + 10}");
}
