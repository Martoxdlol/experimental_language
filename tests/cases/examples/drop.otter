//@ kind: run
//@ description: example program — drop (self-contained, real imports)
//@ stdout:
//~ done

import { Future } from "core:prelude";
// Drop (docs/10, docs/16 §8): a finalizer the runtime runs before reclaiming a
// managed object. Implement `Drop` for a type and its `drop(self)` runs when the
// collector observes the object as unreachable — non-waiting and best-effort
// (it is NOT a scope-exit hook; for deterministic release, call a method
// explicitly and await it if that release may wait).

import { println } from "std:io";
import { Drop } from "core:prelude";

struct Resource { id: i64 }

extend Resource: Drop {
  function drop(self) {
    null
  }
}

function main(): Future<null> async {
  // Each `r` becomes unreachable at the end of its iteration; the collector
  // finalizes it (run with OTTER_FUSION_GC=stress to see this happen promptly).
  var i: i64 = 0;
  while i < 5 {
    var r: Resource = Resource { id: i };
    i = i + 1;
  }
  await println("done");
  null
}
