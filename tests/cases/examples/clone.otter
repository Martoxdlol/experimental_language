//@ kind: run
//@ description: example program — clone (self-contained, real imports)
//@ stdout:
//~ a.to.x = 3
//~ b.to.x = 99
//~ int  = 7
//~ str  = hello
//~ xs.size = 3
//~ ys.size = 4
//~ box  = 1
//~ box2 = 50
//~ pair = 8 wide

// `Clone` (docs/10, docs/15 §8) — deep-copy entry point.
//
// `@Derive(Clone)` synthesises a field-by-field deep copy. Primitives and `str`
// clone trivially (immutable values can be shared); nested structs recurse
// through their own `Clone` impl, so mutating a clone never affects the
// original. Builtin `List`/`Map` of immutable elements clone their storage.

import { List, Map } from "core:collections";
import { println } from "std:io";
import { Clone } from "core:prelude";

@Derive(Clone)
struct Point { x: i64, y: i64 }

@Derive(Clone)
struct Line { from: Point, to: Point }

// `@Derive(Clone)` works on generic structs too: the impl becomes
// `extend<T: Clone> Box<T>: Clone`, so a `Box<T>` is cloneable whenever its
// element is. Tuple structs are supported as well, and their type arguments are
// inferred from the construction.
@Derive(Clone)
struct Box<T> { value: T }

@Derive(Clone)
struct Pair<A, B>(A, B)

// A generic function bounded by `Clone` can clone any qualifying argument.
function duplicate<T: Clone>(value: T): T {
  value.clone()
}

function main() {
  // A deep copy is independent of its source.
  var a: Line = Line { from: Point { x: 0, y: 0 }, to: Point { x: 3, y: 4 } };
  var b: Line = a.clone();
  b.to.x = 99;
  println("a.to.x = " + (a.to.x as str));   // 3 — unaffected
  println("b.to.x = " + (b.to.x as str));   // 99

  // Through a `T: Clone` bound, builtins clone intrinsically.
  println("int  = " + (duplicate<i64>(7) as str));
  println("str  = " + duplicate<str>("hello"));

  // A cloned list is independent of the original.
  var xs: List<i64> = [1, 2, 3];
  var ys: List<i64> = xs.clone();
  ys.push(4);
  println("xs.size = " + (xs.size() as str)); // 3
  println("ys.size = " + (ys.size() as str)); // 4

  // Generic structs: a deep copy through the synthesised generic impl.
  var box: Box<Point> = Box { value: Point { x: 1, y: 2 } };
  var box2: Box<Point> = box.clone();
  box2.value.x = 50;
  println("box  = " + (box.value.x as str));   // 1 — unaffected
  println("box2 = " + (box2.value.x as str));  // 50

  // Tuple struct with inferred type arguments (`Pair<i64, str>`).
  var pair: Pair<i64, str> = Pair(8, "wide");
  var pair2 = pair.clone();
  println("pair = " + (pair2.0 as str) + " " + pair2.1); // 8 wide
}
