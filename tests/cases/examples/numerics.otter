//@ kind: run
//@ description: example program — numerics (self-contained, real imports)
//@ stdout:
//~ i32 range: -2147483648 .. 2147483647
//~ u8.MAX = 255
//~ wrapping = -2147483648
//~ saturating = 2147483647
//~ checked(MAX+1) = overflow
//~ checked(40+2) = 42
//~ overflowing = (1410065408, true)
//~ checked_div(MIN/-1) = overflow
//~ saturating_div(MIN/-1) = 2147483647
//~ checked_neg(MIN) = overflow
//~ wrapping_shl(1, 5) = 32
//~ checked_shl(1, 64) = overflow
//~ 0/0 is_nan = true
//~ INFINITY finite = false

import { Future } from "core:prelude";
// Numeric helper namespaces (docs/18 §10, docs/14 §5): constants and the
// explicit overflow-arithmetic families on primitive integer/float types,
// called as `i32.MAX`, `i32.wrapping_add(a, b)`, `f64.is_nan(x)`, …

import { println } from "std:io";

function describe(r: i32 | null): str {
  match r { i32 v => v as str, null => "overflow" }
}

function main(): Future<null> async {
  // Limits.
  await println("i32 range: " + (i32.MIN as str) + " .. " + (i32.MAX as str));
  await println("u8.MAX = " + (u8.MAX as str));

  var big: i32 = 2147483647;          // i32::MAX

  // wrapping: two's-complement wrap.
  await println("wrapping = " + (i32.wrapping_add(big, 1) as str));   // MIN
  // saturating: clamp to the bound.
  await println("saturating = " + (i32.saturating_add(big, 100) as str)); // MAX
  // checked: null on overflow.
  await println("checked(MAX+1) = " + describe(i32.checked_add(big, 1)));
  await println("checked(40+2) = " + describe(i32.checked_add(40, 2)));
  // overflowing: (value, did_overflow).
  var ov: (i32, bool) = i32.overflowing_mul(100000, 100000);
  await println("overflowing = (" + (ov.0 as str) + ", " + (ov.1 as str) + ")");

  // The same families exist for div, rem, neg, shl, shr. The only signed
  // overflow case for / and % is INT_MIN / -1 (resp. % -1 → 0).
  var neg1: i32 = (0 - 1) as i32;
  await println("checked_div(MIN/-1) = " + describe(i32.checked_div(i32.MIN, neg1)));
  await println("saturating_div(MIN/-1) = " + (i32.saturating_div(i32.MIN, neg1) as str));
  await println("checked_neg(MIN) = " + describe(i32.checked_neg(i32.MIN)));
  await println("wrapping_shl(1, 5) = " + (i32.wrapping_shl(1 as i32, 5u32) as str));
  await println("checked_shl(1, 64) = " + describe(i32.checked_shl(1 as i32, 64u32)));

  // Float constants and predicates.
  var zero: f64 = 0.0;
  await println("0/0 is_nan = " + (f64.is_nan(zero / zero) as str));
  await println("INFINITY finite = " + (f64.is_finite(f64.INFINITY) as str));
  null
}
