//@ kind: run
//@ serial
//@ description: example program — channels (self-contained, real imports)
//@ stdout:
//~ sum of squares 1..5 = 55
//~ channel empty, as expected

// Channels (docs/20 §2) are async and non-blocking. `channel<T>()` returns a
// `(Sender<T>, Receiver<T>)` pair; `send` enqueues without blocking (the queue
// is unbounded), and `recv()` returns a `Future<T>` you `await`. Awaiting a
// recv *suspends the task* rather than parking the OS thread, so channels
// compose with the async runtime (docs/21). Endpoints are thread-safe
// handles, so a `Sender` can be captured into a spawned worker.

import { println } from "std:io";
import { Future } from "core:prelude";
import { JoinHandle, Joined, Panicked } from "std:thread";
import { Sender, Receiver } from "std:sync";

import { channel } from "std:sync";
import { Thread } from "std:thread";
function produce(tx: Sender<i64>, n: i64) {
  var i: i64 = 1;
  while i <= n {
    tx.send(i * i);   // send the squares 1, 4, 9, ... (never blocks)
    i = i + 1;
  }
}

// An async consumer: each `await rx.recv()` suspends until a message arrives.
function consume(rx: Receiver<i64>, n: i64): Future<i64> async {
  var total: i64 = 0;
  var got: i64 = 0;
  while got < n {
    var m: i64 = await rx.recv();
    total = total + m;
    got = got + 1;
  }
  total
}

// An async `main`: the runtime drives the root future automatically.
function main(): Future<null> async {
  var pair: (Sender<i64>, Receiver<i64>) = channel<i64>();
  var tx: Sender<i64> = pair.0;
  var rx: Receiver<i64> = pair.1;

  // A worker thread produces; the main task consumes asynchronously. The
  // consumer suspends on each empty recv and is woken by the worker's `send`.
  var worker: JoinHandle<i64> = Thread.spawn(() => { produce(tx, 5); 0 });

  var total: i64 = await consume(rx, 5);
  // `worker.join()` is also async — `await` it (the calling task suspends
  // instead of parking the OS thread).
  var r: Joined<i64> | Panicked = await worker.join();
  println("sum of squares 1..5 = " + (total as str));   // 1+4+9+16+25 = 55

  // `try_recv` polls without blocking and without a future: `T | null`.
  match rx.try_recv() {
    i64 n => println("unexpected: " + (n as str)),
    null => println("channel empty, as expected"),
  }
}
