//@ kind: run
//@ description: example program — static_methods (self-contained, real imports)
//@ stdout:
//~ origin manhattan = 0
//~ p manhattan = 7
//~ config level = 1
//~ primitive default = 0
//~ box i = 7
//~ box s = hi

import { Future } from "core:prelude";
// Static methods (docs/10 §10): functions in an `extend`/`interface` block that
// take no `self`, called as `Type.method(args)` — the `.` analogue of Rust's
// `Type::method(args)`. There is no `static` keyword; absence of `self` is the
// signal.

import { println } from "std:io";

struct Point { x: i64, y: i64 }

extend Point {
  // Associated "constructors" — no `self`, called on the type.
  function origin(): Point { Point { x: 0, y: 0 } }
  function at(x: i64, y: i64): Point { Point { x: x, y: y } }
  // An ordinary instance method, for contrast.
  function manhattan(self): i64 { self.x + self.y }
}

// An interface can declare a static method (returning `Self`), the way Rust's
// `Default::default` works.
interface Default {
  function default(): Self;
}

struct Config { verbose: i64, level: i64 }
extend Config: Default {
  function default(): Config { Config { verbose: 0, level: 1 } }
}

// Primitive names are extendable type names too, so their static methods use
// the same syntax.
extend i32: Default {
  function default(): i32 { 0 }
}

// Generic code can call a static method through a bound: `T.default()` resolves
// to whatever concrete type `T` is instantiated with (monomorphized).
function build<T: Default>(): T {
  T.default()
}

// A static method on a generic type — `Box.new(99)` infers `Box<i64>` from the
// argument's type (docs/11 §3); no explicit `<i64>` needed, just like generic
// free-function inference.
struct Box<T> { value: T }
extend<T> Box<T> {
  function new(v: T): Box<T> { Box { value: v } }
}

function main(): Future<null> async {
  var o: Point = Point.origin();
  var p: Point = Point.at(3, 4);
  await println("origin manhattan = " + (o.manhattan() as str));
  await println("p manhattan = " + (p.manhattan() as str));

  var c: Config = build<Config>();
  await println("config level = " + (c.level as str));
  await println("primitive default = " + (i32.default() as str));

  // No `<i64>`/`<str>` here — the receiver's type args fall out of the args.
  var bi = Box.new(7);
  var bs = Box.new("hi");
  await println("box i = " + (bi.value as str));
  await println("box s = " + bs.value);
  null
}
