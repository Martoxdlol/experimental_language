//@ kind: run
//@ description: && and || short-circuit evaluation
//@ stdout:
//~ false
//~ true
//~ true
//~ false
import { Future } from "core:prelude";
import { println } from "std:io";
function main(): Future<null> async {
  await println("${true && false}");
  await println("${true || false}");
  await println("${false || true}");
  await println("${!true}");
  null
}
