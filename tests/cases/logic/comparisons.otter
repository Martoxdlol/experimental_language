//@ kind: run
//@ description: relational operators
//@ stdout:
//~ true
//~ false
//~ true
//~ true
//~ false
//~ true
import { Future } from "core:prelude";
import { println } from "std:io";
function main(): Future<null> async {
  await println("${1 < 2}");
  await println("${2 < 1}");
  await println("${2 <= 2}");
  await println("${3 > 2}");
  await println("${3 >= 4}");
  await println("${5 == 5}");
  null
}
